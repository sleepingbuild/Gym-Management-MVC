@model GYM_MANAGEMENT_SYSTEM.ViewModels.ChatViewModel

@{
    ViewData["Title"] = "AI Fitness Trainer";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - IronFit</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/GYM_MANAGEMENT_SYSTEM.styles.css" asp-append-version="true" />
</head>
<body>
<header>
    <nav class="navbar navbar-expand-lg site-navbar sticky-top" id="chatNavbar">
        <div class="container-fluid container">
            <a class="navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="brand-mark">🏋️</span>
                <span>IronFit</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                    aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="navbar-collapse collapse d-lg-inline-flex justify-content-between">
                <ul class="navbar-nav flex-grow-1">
                    <li class="nav-item">
                        <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                            @{
                                var homeLabel = "Trang chủ";
                                if (User.IsInRole("Admin")) { homeLabel = "Dashboard"; }
                                else if (User.IsInRole("Trainer")) { homeLabel = "Bảng điều khiển"; }
                            }
                            @homeLabel
                        </a>
                    </li>
                    @if (User.Identity!.IsAuthenticated && !User.IsInRole("Trainer") && !User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Membership" asp-action="Index">Gói tập</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Trainer" asp-action="Index">Huấn luyện viên</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Booking" asp-action="Index">Đặt lịch</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="FaceAttendance" asp-action="SelfCheckIn">Điểm danh khuôn mặt</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Workout" asp-action="Index">Tiến trình</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="AI" asp-action="Chat">Trợ lý AI</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Payment" asp-action="Index">Thanh toán</a>
                        </li>
                    }
                    @if (User.IsInRole("Trainer"))
                    {
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="AI" asp-action="Chat">Trợ lý AI</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-user-tie me-1"></i>Khu vực HLV
                            </a>
                            <ul class="dropdown-menu admin-dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="TrainerPortal" asp-action="Index">
                                        <i class="fas fa-chart-line me-2"></i>Bảng điều khiển
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TrainerPortal" asp-action="Students">
                                        <i class="fas fa-users me-2"></i>Khách hàng của tôi
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TrainerPortal" asp-action="Timetable">
                                        <i class="fas fa-calendar-alt me-2"></i>Thời khoá biểu
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TrainerPortal" asp-action="Progress">
                                        <i class="fas fa-chart-bar me-2"></i>Tiến trình hội viên
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="TrainerPortal" asp-action="Attendance">
                                        <i class="fas fa-clipboard-check me-2"></i>Chấm công
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="FaceAttendance" asp-action="SelfCheckIn">
                                        <i class="fas fa-camera me-2"></i>Điểm danh bằng khuôn mặt
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                    @if (User.IsInRole("Admin"))
                    {
                        <li class="nav-item">
                            <a class="nav-link active" asp-controller="AI" asp-action="Chat">Trợ lý AI</a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fas fa-shield-alt me-1"></i>Quản trị
                            </a>
                            <ul class="dropdown-menu admin-dropdown-menu">
                                <li>
                                    <a class="dropdown-item" asp-controller="Dashboard" asp-action="Index">
                                        <i class="fas fa-chart-line me-2"></i>Dashboard
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Package" asp-action="Index">
                                        <i class="fas fa-box me-2"></i>Quản lý gói tập
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Member" asp-action="Index">
                                        <i class="fas fa-users me-2"></i>Quản lý thành viên
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Trainer" asp-action="Index">
                                        <i class="fas fa-user-tie me-2"></i>Quản lý huấn luyện viên
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Schedule" asp-action="Index">
                                        <i class="fas fa-calendar-alt me-2"></i>Lịch làm việc HLV
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Payment" asp-action="AdminHistory">
                                        <i class="fas fa-file-invoice-dollar me-2"></i>Lịch sử thanh toán
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="Attendance" asp-action="Index">
                                        <i class="fas fa-clipboard-check me-2"></i>Chấm công HLV
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider" /></li>
                                <li>
                                    <a class="dropdown-item" asp-controller="FaceProfile" asp-action="AdminRegister">
                                        <i class="fas fa-id-badge me-2"></i>Đăng ký khuôn mặt
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" asp-controller="FaceAttendance" asp-action="Kiosk">
                                        <i class="fas fa-camera me-2"></i>Kiosk điểm danh
                                    </a>
                                </li>
                            </ul>
                        </li>
                    }
                </ul>
                <partial name="_LoginPartial" />
            </div>
        </div>
    </nav>
</header>
<style>
    :root {
        --gym-dark: #0f1117;
        --gym-card: #1a1d27;
        --gym-border: #2a2d3a;
        --gym-accent: #f97316;
        --gym-accent2: #fb923c;
        --gym-text: #e2e8f0;
        --gym-muted: #64748b;
        --gym-bot-bg: #1a1d27;
        --gym-input: #12151e;
        --radius: 14px;
        --sidebar-width: 260px;
        --navbar-height: 64px;
    }

    * { box-sizing: border-box; }
    body { background: var(--gym-dark); color: var(--gym-text); margin: 0; font-family: 'Inter', system-ui, sans-serif; }

    .app-shell { display: flex; }

    .sidebar {
        width: var(--sidebar-width);
        flex-shrink: 0;
        height: calc(100vh - var(--navbar-height));
        position: fixed;
        left: 0; top: var(--navbar-height);
        z-index: 90;
        background: var(--gym-card);
        border-right: 1px solid var(--gym-border);
        padding: 1rem;
        overflow-y: auto;
        display: flex;
        flex-direction: column;
        gap: .75rem;
    }

    .new-chat-btn {
        width: 100%;
        background: linear-gradient(135deg, var(--gym-accent), var(--gym-accent2));
        border: none;
        color: #fff;
        padding: .65rem 1rem;
        border-radius: 10px;
        font-size: .85rem;
        font-weight: 600;
        cursor: pointer;
    }

    .session-list { display: flex; flex-direction: column; gap: 4px; margin-top: .5rem; }

    .session-item {
        display: block;
        padding: .55rem .7rem;
        border-radius: 8px;
        color: var(--gym-muted);
        text-decoration: none;
        font-size: .82rem;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        transition: background .15s, color .15s;
    }
    .session-item:hover { background: rgba(255,255,255,.05); color: var(--gym-text); }
    .session-item.active { background: rgba(249,115,22,.12); color: var(--gym-text); border: 1px solid rgba(249,115,22,.3); }

    .main-content { margin-left: var(--sidebar-width); width: calc(100% - var(--sidebar-width)); }

    .chat-wrapper { max-width: 820px; margin: 0 auto; padding: 2rem 1rem 6rem; }

    .chat-header { display: flex; align-items: center; gap: 14px; margin-bottom: 2rem; padding-bottom: 1.25rem; border-bottom: 1px solid var(--gym-border); }
    .chat-header .avatar { width: 48px; height: 48px; background: linear-gradient(135deg, var(--gym-accent), #ef4444); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 22px; flex-shrink: 0; box-shadow: 0 0 20px rgba(249,115,22,.35); }
    .chat-header h1 { font-size: 1.25rem; font-weight: 700; margin: 0; letter-spacing: -.01em; }
    .chat-header p { font-size: .8rem; color: var(--gym-muted); margin: 2px 0 0; }
    .status-dot { display: inline-block; width: 7px; height: 7px; background: #22c55e; border-radius: 50%; margin-right: 5px; animation: pulse 2s infinite; }
    @@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: .4; } }

    .chat-summary { background: var(--gym-card); border: 1px dashed var(--gym-border); border-radius: var(--radius); padding: .8rem 1.1rem; margin-bottom: 1.75rem; opacity: .65; transition: opacity .3s; }
    .chat-summary:hover { opacity: .95; }
    .chat-summary .summary-label { font-size: .68rem; text-transform: uppercase; letter-spacing: .06em; color: var(--gym-muted); margin-bottom: 5px; font-weight: 600; }
    .chat-summary .summary-text { font-size: .82rem; line-height: 1.55; color: var(--gym-muted); font-style: italic; }

    .date-divider { display: flex; align-items: center; gap: 12px; margin: 1.5rem 0 1.25rem; color: var(--gym-muted); font-size: .72rem; font-weight: 500; }
    .date-divider::before, .date-divider::after { content: ''; flex: 1; height: 1px; background: var(--gym-border); }

    .chat-history { display: flex; flex-direction: column; gap: 1.25rem; margin-bottom: 1.5rem; min-height: 120px; }

    .msg-user { display: flex; justify-content: flex-end; }
    .msg-user .bubble { background: linear-gradient(135deg, var(--gym-accent), var(--gym-accent2)); color: #fff; padding: .75rem 1.1rem; border-radius: var(--radius) var(--radius) 4px var(--radius); max-width: 72%; font-size: .9rem; line-height: 1.55; box-shadow: 0 4px 16px rgba(249,115,22,.2); }

    .msg-bot { display: flex; gap: 10px; align-items: flex-start; }
    .msg-bot .bot-icon { width: 32px; height: 32px; background: linear-gradient(135deg,#7c3aed,#ef4444); border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 14px; flex-shrink: 0; margin-top: 2px; }
    .msg-bot .bubble { background: var(--gym-bot-bg); border: 1px solid var(--gym-border); padding: .75rem 1.1rem; border-radius: var(--radius) var(--radius) var(--radius) 4px; max-width: 72%; font-size: .9rem; line-height: 1.6; color: var(--gym-text); }

    .msg-time { font-size: .7rem; color: var(--gym-muted); margin-top: 4px; text-align: right; }
    .msg-bot .msg-time { text-align: left; padding-left: 42px; }

    .rating-buttons { margin-top: 6px; padding-left: 42px; display: flex; gap: 6px; }
    .rating-buttons .rate-btn { background: none; border: 1px solid var(--gym-border); border-radius: 8px; padding: 2px 9px; cursor: pointer; font-size: .85rem; opacity: .55; transition: opacity .2s, border-color .2s; color: var(--gym-text); }
    .rating-buttons .rate-btn:hover { opacity: 1; }
    .rating-buttons .rate-btn.active { opacity: 1; border-color: var(--gym-accent); }

    .feedback-box { display: none; margin-top: 8px; padding-left: 42px; }
    .feedback-box.show { display: block; }
    .feedback-box textarea { width: 100%; max-width: 320px; background: var(--gym-input); border: 1px solid var(--gym-border); color: var(--gym-text); border-radius: 10px; padding: 8px 10px; font-size: .82rem; resize: none; outline: none; font-family: inherit; }
    .feedback-box textarea:focus { border-color: var(--gym-accent); }
    .feedback-box .feedback-actions { display: flex; gap: 8px; margin-top: 6px; }
    .feedback-box button { border: none; border-radius: 8px; padding: 4px 12px; font-size: .78rem; cursor: pointer; }
    .feedback-box .btn-send { background: var(--gym-accent); color: #fff; }
    .feedback-box .btn-skip { background: none; border: 1px solid var(--gym-border); color: var(--gym-muted); }

    .empty-state { text-align: center; padding: 3rem 1rem; color: var(--gym-muted); }
    .empty-state .icon { font-size: 3rem; margin-bottom: .75rem; }
    .empty-state p { font-size: .9rem; }

    .suggestion-chips { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; margin-top: 1rem; }
    .chip { background: var(--gym-card); border: 1px solid var(--gym-border); color: var(--gym-text); padding: .4rem .9rem; border-radius: 999px; font-size: .78rem; cursor: pointer; transition: border-color .2s, color .2s; text-decoration: none; }
    .chip:hover { border-color: var(--gym-accent); color: var(--gym-accent); }

    .msg-new .bubble { animation: fadeSlide .4s ease; }
    @@keyframes fadeSlide { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: translateY(0); } }

    .input-bar { position: fixed; bottom: 0; left: var(--sidebar-width); right: 0; background: rgba(15,17,23,.92); backdrop-filter: blur(12px); border-top: 1px solid var(--gym-border); padding: 1rem; z-index: 95; }
    .input-inner { max-width: 820px; margin: 0 auto; display: flex; gap: 10px; align-items: center; }
    .input-inner input[type=text] { flex: 1; background: var(--gym-input); border: 1px solid var(--gym-border); color: var(--gym-text); border-radius: 999px; padding: .7rem 1.25rem; font-size: .9rem; outline: none; transition: border-color .2s; }
    .input-inner input[type=text]:focus { border-color: var(--gym-accent); }
    .input-inner input[type=text]::placeholder { color: var(--gym-muted); }

    .send-btn { width: 44px; height: 44px; background: linear-gradient(135deg, var(--gym-accent), var(--gym-accent2)); border: none; border-radius: 50%; color: #fff; font-size: 18px; cursor: pointer; display: flex; align-items: center; justify-content: center; flex-shrink: 0; transition: transform .15s, box-shadow .15s; box-shadow: 0 4px 12px rgba(249,115,22,.3); }
    .send-btn:hover { transform: scale(1.08); }
    .send-btn:active { transform: scale(.96); }
</style>

<div class="app-shell">
    <aside class="sidebar">
        <form method="post" asp-action="NewSession" asp-controller="AI">
            @Html.AntiForgeryToken()
            <button type="submit" class="new-chat-btn">+ Cuộc trò chuyện mới</button>
        </form>
        <div class="session-list">
            @foreach (var s in Model.Sessions)
            {
                <a class="session-item @(s.Id == Model.SessionId ? "active" : "")"
                   href="@Url.Action("Chat", "AI", new { sessionId = s.Id })">
                    @s.Title
                </a>
            }
        </div>
    </aside>

    <div class="main-content">
        <div class="chat-wrapper">

            <div class="chat-header">
                <div class="avatar">🏋️</div>
                <div>
                    <h1>AI Fitness Trainer</h1>
                    <p><span class="status-dot"></span>Sẵn sàng tư vấn</p>
                </div>
            </div>

            <div class="chat-history" id="chatHistory">

                @if (!string.IsNullOrEmpty(Model.SummaryText))
                {
                    <div class="chat-summary" id="chatSummaryBox">
                        <div class="summary-label">📝 Tóm tắt các tin nhắn trước đó</div>
                        <div class="summary-text" id="chatSummaryText">@Model.SummaryText</div>
                    </div>
                }

                @if (!Model.Histories.Any())
                {
                    <div class="empty-state">
                        <div class="icon">💪</div>
                        <p>Chào bạn! Hãy hỏi tôi bất cứ điều gì về<br />tập luyện, dinh dưỡng và sức khoẻ.</p>
                        <div class="suggestion-chips">
                            <a class="chip" onclick="fillQuestion(this)">Tập gym mấy ngày/tuần?</a>
                            <a class="chip" onclick="fillQuestion(this)">Whey protein có cần thiết không?</a>
                            <a class="chip" onclick="fillQuestion(this)">Cách giảm mỡ bụng hiệu quả?</a>
                            <a class="chip" onclick="fillQuestion(this)">Squat đúng kỹ thuật như thế nào?</a>
                        </div>
                    </div>
                }

                @{
                    DateTime? lastDate = null;
                }
                @foreach (var item in Model.Histories.OrderBy(x => x.CreatedAt))
                {
                    var itemDate = item.CreatedAt.ToLocalTime().Date;
                    if (lastDate == null || itemDate != lastDate)
                    {
                        <div class="date-divider">@itemDate.ToString("dd/MM/yyyy")</div>
                        lastDate = itemDate;
                    }
                    <div class="msg-user">
                        <div>
                            <div class="bubble">@item.Question</div>
                            <div class="msg-time">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                        </div>
                    </div>
                    <div class="msg-bot">
                        <div class="bot-icon">🤖</div>
                        <div>
                            <div class="bubble">@item.Answer</div>
                            <div class="msg-time">@item.CreatedAt.ToLocalTime().ToString("HH:mm")</div>
                            <div class="rating-buttons" data-chat-id="@item.Id">
                                <button class="rate-btn" data-rating="1" title="Hữu ích">👍</button>
                                <button class="rate-btn" data-rating="-1" title="Không hữu ích">👎</button>
                            </div>
                            <div class="feedback-box">
                                <textarea rows="2" placeholder="Bạn muốn góp ý thêm gì về câu trả lời này? (không bắt buộc)"></textarea>
                                <div class="feedback-actions">
                                    <button type="button" class="btn-send">Gửi</button>
                                    <button type="button" class="btn-skip">Bỏ qua</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }

            </div>
        </div>
    </div>
</div>

<div class="input-bar">
    <form class="input-inner" id="chatForm">
        @Html.AntiForgeryToken()
        <input id="questionInput" name="question" type="text" placeholder="Hỏi về workout, dinh dưỡng, lịch tập..." autocomplete="off" />
        <button type="submit" class="send-btn" title="Gửi">➤</button>
    </form>
</div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script>
    const chatHistory = document.getElementById('chatHistory');
    const chatForm = document.getElementById('chatForm');
    const questionInput = document.getElementById('questionInput');
    const currentSessionId = @Model.SessionId;

    let lastRenderedDateStr = @Html.Raw(
        Model.Histories.Any()
            ? $"'{Model.Histories.Max(h => h.CreatedAt).ToLocalTime().Date:yyyy-MM-dd}'"
            : "null"
    );

    window.addEventListener('load', () => chatHistory.scrollTop = chatHistory.scrollHeight);

    function fillQuestion(el) {
        questionInput.value = el.textContent.trim();
        questionInput.focus();
    }

    function scrollToBottom() { chatHistory.scrollTop = chatHistory.scrollHeight; }

    function formatDate(d) {
        return d.toLocaleDateString('vi-VN', { day: '2-digit', month: '2-digit', year: 'numeric' });
    }

    function maybeInsertDateDivider() {
        const today = new Date();
        const todayStr = today.toISOString().slice(0, 10);
        if (lastRenderedDateStr !== todayStr) {
            const divider = document.createElement('div');
            divider.className = 'date-divider';
            divider.textContent = formatDate(today);
            chatHistory.appendChild(divider);
            lastRenderedDateStr = todayStr;
        }
    }

    function updateSummaryBox(summaryText) {
        if (!summaryText) return;
        let box = document.getElementById('chatSummaryBox');
        if (!box) {
            box = document.createElement('div');
            box.className = 'chat-summary';
            box.id = 'chatSummaryBox';
            box.innerHTML = `<div class="summary-label">📝 Tóm tắt các tin nhắn trước đó</div><div class="summary-text" id="chatSummaryText"></div>`;
            chatHistory.insertBefore(box, chatHistory.firstChild);
        }
        document.getElementById('chatSummaryText').textContent = summaryText;
    }

    function typeText(el, text, charsPerSecond = 60) {
        return new Promise(resolve => {
            let i = 0;
            let lastTime = null;
            function step(timestamp) {
                if (lastTime === null) lastTime = timestamp;
                const elapsed = timestamp - lastTime;
                const charsToShow = Math.floor((elapsed / 1000) * charsPerSecond);
                if (charsToShow > 0) {
                    i = Math.min(i + charsToShow, text.length);
                    el.textContent = text.slice(0, i);
                    lastTime = timestamp;
                    scrollToBottom();
                }
                if (i < text.length) requestAnimationFrame(step);
                else resolve();
            }
            requestAnimationFrame(step);
        });
    }

    let pendingRating = {};

    document.addEventListener('click', async function (e) {
        if (e.target.classList.contains('rate-btn')) {
            const btn = e.target;
            const wrapper = btn.closest('.rating-buttons');
            const chatId = wrapper.dataset.chatId;
            const rating = btn.dataset.rating;
            if (!chatId) return;

            wrapper.querySelectorAll('.rate-btn').forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            await submitFeedback(chatId, rating, null);

            const box = wrapper.nextElementSibling;
            if (box && box.classList.contains('feedback-box')) {
                box.classList.add('show');
                pendingRating[chatId] = rating;
                box.querySelector('textarea').focus();
            }
            return;
        }

        if (e.target.classList.contains('btn-send')) {
            const box = e.target.closest('.feedback-box');
            const wrapper = box.previousElementSibling;
            const chatId = wrapper.dataset.chatId;
            const comment = box.querySelector('textarea').value.trim();
            const rating = pendingRating[chatId];

            if (comment) {
                await submitFeedback(chatId, rating, comment);
            }
            box.classList.remove('show');
            return;
        }

        if (e.target.classList.contains('btn-skip')) {
            const box = e.target.closest('.feedback-box');
            box.classList.remove('show');
            box.querySelector('textarea').value = '';
            return;
        }
    });

    async function submitFeedback(chatId, rating, comment) {
        const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
        const formData = new URLSearchParams();
        formData.append('chatHistoryId', chatId);
        formData.append('rating', rating);
        if (comment) formData.append('comment', comment);
        formData.append('__RequestVerificationToken', token);

        try {
            await fetch('/Feedback/RateAnswer', { method: 'POST', body: formData });
        } catch (err) {
            console.error('Gửi đánh giá thất bại', err);
        }
    }

    chatForm.addEventListener('submit', async function (e) {
        e.preventDefault();
        const question = questionInput.value.trim();
        if (!question) return;

        const sendBtn = chatForm.querySelector('.send-btn');
        sendBtn.disabled = true;
        sendBtn.innerHTML = '⏳';
        questionInput.value = '';
        questionInput.disabled = true;

        const empty = chatHistory.querySelector('.empty-state');
        if (empty) empty.remove();

        maybeInsertDateDivider();

        const userDiv = document.createElement('div');
        userDiv.className = 'msg-user';
        userDiv.innerHTML = `<div><div class="bubble"></div></div>`;
        userDiv.querySelector('.bubble').textContent = question;
        chatHistory.appendChild(userDiv);

        const botDiv = document.createElement('div');
        botDiv.className = 'msg-bot msg-new';
        botDiv.innerHTML = `
            <div class="bot-icon">🤖</div>
            <div>
                <div class="bubble"></div>
                <div class="rating-buttons" data-chat-id="">
                    <button class="rate-btn" data-rating="1" title="Hữu ích">👍</button>
                    <button class="rate-btn" data-rating="-1" title="Không hữu ích">👎</button>
                </div>
                <div class="feedback-box">
                    <textarea rows="2" placeholder="Bạn muốn góp ý thêm gì về câu trả lời này? (không bắt buộc)"></textarea>
                    <div class="feedback-actions">
                        <button type="button" class="btn-send">Gửi</button>
                        <button type="button" class="btn-skip">Bỏ qua</button>
                    </div>
                </div>
            </div>`;
        const bubble = botDiv.querySelector('.bubble');
        const ratingWrapper = botDiv.querySelector('.rating-buttons');
        chatHistory.appendChild(botDiv);
        scrollToBottom();

        try {
            const token = document.querySelector('input[name="__RequestVerificationToken"]').value;
            const formData = new URLSearchParams();
            formData.append('question', question);
            formData.append('sessionId', currentSessionId);
            formData.append('__RequestVerificationToken', token);

            const response = await fetch('/AI/ChatApi', { method: 'POST', body: formData });
            const data = await response.json();
            await typeText(bubble, data.answer);
            updateSummaryBox(data.summaryText);

            if (data.chatHistoryId) {
                ratingWrapper.dataset.chatId = data.chatHistoryId;
            }

            // Cập nhật tiêu đề session trên sidebar nếu vừa được đổi
            if (data.sessionTitle) {
                const activeItem = document.querySelector('.session-item.active');
                if (activeItem) activeItem.textContent = data.sessionTitle;
            }
        } catch (err) {
            bubble.textContent = 'Xin lỗi, hệ thống AI hiện không khả dụng. Vui lòng thử lại sau.';
            ratingWrapper.remove();
        }

        sendBtn.disabled = false;
        sendBtn.innerHTML = '➤';
        questionInput.disabled = false;
        questionInput.focus();
    });
</script>
</body>
</html>