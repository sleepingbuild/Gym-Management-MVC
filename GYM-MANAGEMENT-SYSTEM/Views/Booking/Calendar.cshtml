@model List<GYM_MANAGEMENT_SYSTEM.ViewModels.BookingIndexViewModel>
@{
    ViewData["Title"] = "Lịch tập của tôi";
    DateTime startOfWeek = ViewBag.StartOfWeek;
    DateTime endOfWeek = ViewBag.EndOfWeek;
    var dayNames = new[] { "Thứ 2", "Thứ 3", "Thứ 4", "Thứ 5", "Thứ 6", "Thứ 7", "Chủ nhật" };
    var today = DateTime.Today;
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="fitness-title">🗓️ Lịch tập của tôi</h1>
            <p class="text-muted mb-0">Các buổi tập bạn đã đặt, xem theo tuần</p>
        </div>
        <a asp-action="Create" class="btn btn-fitness-primary">
            <i class="fas fa-plus-circle me-2"></i>Đặt lịch mới
        </a>
    </div>

    <!-- Week navigation -->
    <div class="card-fitness mb-4">
        <div class="card-body d-flex justify-content-between align-items-center flex-wrap gap-2">
            <div>
                <i class="fas fa-calendar-week me-2" style="color: var(--gym-accent);"></i>
                <strong style="color: var(--gym-text);">Tuần: @startOfWeek.ToString("dd/MM") – @endOfWeek.ToString("dd/MM/yyyy")</strong>
            </div>
            <div class="d-flex gap-2">
                <a asp-action="Calendar" asp-route-weekStart="@startOfWeek.AddDays(-7).ToString("yyyy-MM-dd")" class="btn btn-fitness-secondary btn-sm">
                    <i class="fas fa-chevron-left me-1"></i>Tuần trước
                </a>
                <a asp-action="Calendar" class="btn btn-fitness-secondary btn-sm" style="@(startOfWeek <= today && today <= endOfWeek ? "border-color: var(--gym-accent); color: var(--gym-accent);" : "")">
                    Hôm nay
                </a>
                <a asp-action="Calendar" asp-route-weekStart="@startOfWeek.AddDays(7).ToString("yyyy-MM-dd")" class="btn btn-fitness-secondary btn-sm">
                    Tuần sau<i class="fas fa-chevron-right ms-1"></i>
                </a>
            </div>
        </div>
    </div>

    <!-- Weekly grid -->
    <div class="row g-3">
        @for (int i = 0; i < 7; i++)
        {
            var day = startOfWeek.AddDays(i);
            var isToday = day.Date == today;
            var dayBookings = Model.Where(b => b.SessionDate.Date == day.Date).ToList();

            <div class="col-lg col-md-6">
                <div class="card-fitness h-100" style="@(isToday ? "border-color: var(--gym-accent);" : "")">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span>@dayNames[i]</span>
                        <span class="small @(isToday ? "" : "text-muted")" style="@(isToday ? "color: var(--gym-accent); font-weight:700;" : "")">
                            @day.ToString("dd/MM")
                        </span>
                    </div>
                    <div class="card-body" style="min-height: 140px;">
                        @if (dayBookings.Any())
                        {
                            foreach (var b in dayBookings)
                            {
                                <div class="mb-2 p-2" style="background: var(--gym-input); border-radius: var(--radius-sm); border: 1px solid var(--gym-border);">
                                    <div class="d-flex justify-content-between align-items-start">
                                        <span class="fw-semibold small" style="color: var(--gym-text);">
                                            <i class="fas fa-clock me-1" style="color: var(--gym-muted);"></i>@b.TimeDisplay
                                        </span>
                                        <span class="@b.StatusBadgeClass" style="font-size: .68rem; padding: .2rem .5rem;">@b.StatusDisplay</span>
                                    </div>
                                    <div class="small text-muted mt-1">
                                        <i class="fas fa-user-tie me-1"></i>@b.TrainerName
                                    </div>
                                    <a asp-action="Details" asp-route-id="@b.Id" class="small" style="color: var(--gym-accent);">Chi tiết →</a>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-3">
                                <i class="fas fa-calendar" style="font-size: 1.2rem; color: var(--gym-border);"></i>
                                <p class="small text-muted mb-0 mt-1">Trống</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        }
    </div>
</div>
