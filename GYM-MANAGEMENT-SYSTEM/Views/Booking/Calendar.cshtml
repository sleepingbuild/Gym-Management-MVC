@{
    ViewData["Title"] = "Lịch biểu tập luyện";
    var trainers = ViewBag.Trainers as IEnumerable<GYM_MANAGEMENT_SYSTEM.Models.Trainer>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fitness-title">📅 Lịch biểu tập luyện</h1>
            <p class="text-muted">Xem lịch tập theo tuần</p>
        </div>
        <a asp-action="Create" class="btn btn-fitness-primary">
            <i class="fas fa-plus-circle me-2"></i>Đặt lịch mới
        </a>
    </div>

    <!-- Filter -->
    <div class="card-fitness mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-6">
                    <label class="form-label">
                        <i class="fas fa-user-tie me-2"></i>Chọn huấn luyện viên
                    </label>
                    <select class="form-control" id="trainerFilter">
                        <option value="">-- Tất cả --</option>
                        @if (trainers != null)
                        {
                            @foreach (var trainer in trainers)
                            {
                                <option value="@trainer.Id">@trainer.FullName</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <label class="form-label">
                        <i class="fas fa-calendar-week me-2"></i>Tuần
                    </label>
                    <input type="week" class="form-control" id="weekFilter" />
                </div>
                <div class="col-md-2">
                    <button class="btn btn-fitness-primary w-100" onclick="loadCalendar()">
                        <i class="fas fa-search me-1"></i>Xem
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Calendar -->
    <div class="card-fitness">
        <div class="card-header">
            <i class="fas fa-calendar-alt me-2"></i>Lịch tập
        </div>
        <div class="card-body" id="calendarContainer">
            <div class="text-center py-5">
                <i class="fas fa-calendar-alt" style="font-size: 3rem; color: var(--text-muted);"></i>
                <p class="text-muted mt-3">Chọn huấn luyện viên và tuần để xem lịch</p>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function loadCalendar() {
            var trainerId = $('#trainerFilter').val();
            var week = $('#weekFilter').val();

            if (!trainerId || !week) {
                $('#calendarContainer').html(`
                    <div class="text-center py-5">
                        <i class="fas fa-exclamation-circle" style="font-size: 3rem; color: var(--warning-yellow);"></i>
                        <p class="text-muted mt-3">Vui lòng chọn huấn luyện viên và tuần</p>
                    </div>
                `);
                return;
            }

            // Parse week
            var parts = week.split('-W');
            var year = parseInt(parts[0]);
            var weekNum = parseInt(parts[1]);

            // Get Monday of week
            var firstDay = new Date(year, 0, 1);
            var days = 1 + (weekNum - 1) * 7;
            firstDay.setDate(days);
            while (firstDay.getDay() !== 1) {
                firstDay.setDate(firstDay.getDate() - 1);
            }

            // Generate week days
            var daysOfWeek = ['Thứ 2', 'Thứ 3', 'Thứ 4', 'Thứ 5', 'Thứ 6', 'Thứ 7', 'Chủ nhật'];
            var html = `
                <div class="table-responsive">
                    <table class="table table-fitness">
                        <thead>
                            <tr>
                                <th>Giờ</th>
                                ${daysOfWeek.map(d => `<th>${d}</th>`).join('')}
                            </tr>
                        </thead>
                        <tbody>
                    `;

            // Generate time slots from 8:00 to 20:00
            for (var hour = 8; hour <= 20; hour++) {
                var time = hour.toString().padStart(2, '0') + ':00';
                html += `<tr><td><strong>${time}</strong></td>`;
                for (var i = 0; i < 7; i++) {
                    var date = new Date(firstDay);
                    date.setDate(firstDay.getDate() + i);
                    var dateStr = date.toISOString().split('T')[0];
                    html += `<td data-date="${dateStr}" data-time="${time}" data-trainer="${trainerId}">
                                <span class="text-muted">-</span>
                            </td>`;
                }
                html += `</tr>`;
            }

            html += `
                        </tbody>
                    </table>
                </div>
            `;

            $('#calendarContainer').html(html);

            // Load bookings for each cell
            var cells = $('td[data-date]');
            cells.each(function() {
                var cell = $(this);
                var date = cell.data('date');
                var time = cell.data('time');
                var trainerId = cell.data('trainer');

                $.ajax({
                    url: '@Url.Action("GetSlots", "Booking")',
                    type: 'GET',
                    data: { trainerId: trainerId, date: date },
                    success: function(data) {
                        if (data.bookedSlots && data.bookedSlots.includes(time)) {
                            cell.html('<span class="badge-fitness orange">Đã đặt</span>');
                        } else {
                            cell.html('<span class="badge-fitness green">Trống</span>');
                        }
                    },
                    error: function() {
                        cell.html('<span class="text-danger">Lỗi</span>');
                    }
                });
            });
        }

        // Set default week to current week
        $(document).ready(function() {
            var now = new Date();
            var year = now.getFullYear();
            var startOfYear = new Date(year, 0, 1);
            var days = Math.floor((now - startOfYear) / (24 * 60 * 60 * 1000));
            var weekNum = Math.ceil((days + startOfYear.getDay() + 1) / 7);
            $('#weekFilter').val(`${year}-W${weekNum.toString().padStart(2, '0')}`);
        });
    </script>
}