@model GYM_MANAGEMENT_SYSTEM.ViewModels.BookingCreateViewModel
@{
    ViewData["Title"] = "Đặt lịch tập";
    var trainers = ViewBag.Trainers as IEnumerable<GYM_MANAGEMENT_SYSTEM.Models.Trainer>;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-calendar-plus me-2"></i>Đặt lịch tập
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success mb-3">
                            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger mb-3">
                            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
                        </div>
                    }
                    <form asp-action="Create" method="post" id="bookingForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="TrainerId" class="form-label">
                                <i class="fas fa-user-tie me-2"></i>Chọn huấn luyện viên
                            </label>
                            <select asp-for="TrainerId" class="form-control" id="trainerSelect">
                                <option value="">-- Chọn huấn luyện viên --</option>
                                @if (trainers != null)
                                {
                                    @foreach (var trainer in trainers)
                                    {
                                        <option value="@trainer.Id">@trainer.FullName - @trainer.Specialization</option>
                                    }
                                }
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Age" class="form-label">
                                <i class="fas fa-birthday-cake me-2"></i>Tuổi của bạn
                            </label>
                            <input asp-for="Age" class="form-control" type="number" id="ageInput" min="10" max="90" placeholder="VD: 25" />
                            <span asp-validation-for="Age" class="text-danger small"></span>
                            <span id="ageWarning" class="text-danger small" style="display: none;"></span>
                            <div class="small mt-1" style="color: var(--gym-muted);">
                                Vui lòng nhập đúng tuổi thật (từ 10 đến 90) để huấn luyện viên tư vấn giáo án phù hợp.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SessionDate" class="form-label">
                                <i class="fas fa-calendar-day me-2"></i>Ngày tập
                            </label>
                            <input asp-for="SessionDate" class="form-control" type="date" id="sessionDate" />
                            <span asp-validation-for="SessionDate" class="text-danger small"></span>
                            <span id="sessionDateWarning" class="text-danger small" style="display: none;"></span>
                            <div class="small mt-1" style="color: var(--gym-muted);">
                                Chỉ có thể đặt lịch từ hôm nay đến tối đa 4 tháng tới.
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">
                                <i class="fas fa-clock me-2"></i>Khung giờ
                            </label>
                            <div id="timeSlotContainer">
                                <div class="d-flex flex-wrap gap-2" id="timeSlotList">
                                    <!-- Time slots sẽ được load bằng AJAX -->
                                </div>
                                <input type="hidden" name="TimeSlot" id="selectedTimeSlot" />
                            </div>
                            <span id="timeSlotError" class="text-danger small" style="display: none;">Vui lòng chọn khung giờ</span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">
                                <i class="fas fa-align-left me-2"></i>Ghi chú
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="3"
                                      placeholder="Ghi chú thêm cho huấn luyện viên..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fitness-primary flex-grow-1" id="submitBtn" disabled>
                                <i class="fas fa-check-circle me-2"></i>Xác nhận đặt lịch
                            </button>
                            <a asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var trainerSelect = $('#trainerSelect');
            var sessionDate = $('#sessionDate');
            var sessionDateWarning = $('#sessionDateWarning');
            var ageInput = $('#ageInput');
            var ageWarning = $('#ageWarning');
            var timeSlotList = $('#timeSlotList');
            var selectedTimeSlot = $('#selectedTimeSlot');
            var submitBtn = $('#submitBtn');
            var timeSlotError = $('#timeSlotError');

            // Giới hạn tuổi hợp lệ (khớp với BookingCreateViewModel.MinAge/MaxAge ở server)
            var MIN_AGE = 10;
            var MAX_AGE = 90;

            function isAgeValid() {
                var val = ageInput.val();
                if (val === '') {
                    ageWarning.hide();
                    return false;
                }
                var age = parseInt(val, 10);

                if (isNaN(age)) {
                    ageWarning.text('Tuổi không hợp lệ.').show();
                    return false;
                }
                if (age < MIN_AGE) {
                    ageWarning.text('Tuổi quá nhỏ. Tuổi tối thiểu để đăng ký tập là ' + MIN_AGE + '.').show();
                    return false;
                }
                if (age > MAX_AGE) {
                    ageWarning.text('Tuổi quá lớn. Tuổi tối đa để đăng ký tập là ' + MAX_AGE + '.').show();
                    return false;
                }
                var impliedBirthYear = new Date().getFullYear() - age;
                if (impliedBirthYear > new Date().getFullYear()) {
                    ageWarning.text('Tuổi không hợp lệ: năm sinh suy ra chưa đến.').show();
                    return false;
                }
                ageWarning.hide();
                return true;
            }

            ageInput.on('input change', isAgeValid);

            // Giới hạn ngày: từ hôm nay đến tối đa 4 tháng tới (khớp với
            // BookingCreateViewModel.MaxMonthsAhead ở server)
            function toDateInputValue(d) {
                var mm = (d.getMonth() + 1).toString().padStart(2, '0');
                var dd = d.getDate().toString().padStart(2, '0');
                return d.getFullYear() + '-' + mm + '-' + dd;
            }

            var today = new Date();
            today.setHours(0, 0, 0, 0);
            var maxDate = new Date(today);
            maxDate.setMonth(maxDate.getMonth() + 4);

            sessionDate.attr('min', toDateInputValue(today));
            sessionDate.attr('max', toDateInputValue(maxDate));

            function isSessionDateValid() {
                var val = sessionDate.val();
                if (!val) {
                    return false;
                }
                var picked = new Date(val + 'T00:00:00');

                if (picked < today) {
                    sessionDateWarning.text('Ngày tập không được là ngày trong quá khứ. Vui lòng chọn từ hôm nay trở đi.').show();
                    return false;
                }
                if (picked > maxDate) {
                    sessionDateWarning.text('Ngày tập không được cách quá 4 tháng so với hiện tại (tối đa đến ' + toDateInputValue(maxDate).split('-').reverse().join('/') + ').').show();
                    return false;
                }
                sessionDateWarning.hide();
                return true;
            }

            function loadTimeSlots() {
                var trainerId = trainerSelect.val();
                var date = sessionDate.val();

                if (!isSessionDateValid()) {
                    timeSlotList.empty();
                    submitBtn.prop('disabled', true);
                    return;
                }

                if (trainerId && date) {
                    $.ajax({
                        url: '@Url.Action("GetSlots", "Booking")',
                        type: 'GET',
                        data: { trainerId: trainerId, date: date },
                        success: function(data) {
                            timeSlotList.empty();
                            var bookedSlots = data.bookedSlots || [];

                            // Tạo các khung giờ (giả định: 8:00 - 20:00)
                            var slots = [];
                            for (var hour = 8; hour <= 20; hour++) {
                                var time = hour.toString().padStart(2, '0') + ':00';
                                var isBooked = bookedSlots.includes(time);
                                slots.push({
                                    time: time,
                                    isBooked: isBooked
                                });
                            }

                            $.each(slots, function(index, slot) {
                                var btn = $('<button>')
                                    .addClass('btn btn-timeslot')
                                    .addClass(slot.isBooked ? 'btn-timeslot-booked' : 'btn-timeslot-available')
                                    .attr('type', 'button')
                                    .attr('data-time', slot.time)
                                    .text(slot.isBooked ? slot.time + ' (đã đặt)' : slot.time)
                                    .prop('disabled', slot.isBooked);

                                if (!slot.isBooked) {
                                    btn.click(function() {
                                        $('.btn-timeslot').removeClass('btn-timeslot-selected').filter(':not(:disabled)').addClass('btn-timeslot-available');
                                        $(this).removeClass('btn-timeslot-available').addClass('btn-timeslot-selected');
                                        selectedTimeSlot.val($(this).data('time'));
                                        submitBtn.prop('disabled', false);
                                        timeSlotError.hide();
                                    });
                                }

                                timeSlotList.append(btn);
                            });
                        },
                        error: function() {
                            timeSlotList.html('<p class="text-danger">Lỗi tải khung giờ</p>');
                        }
                    });
                } else {
                    timeSlotList.empty();
                    submitBtn.prop('disabled', true);
                }
            }

            trainerSelect.change(loadTimeSlots);
            sessionDate.change(loadTimeSlots);

            // Form submit validation
            $('#bookingForm').submit(function(e) {
                if (!isSessionDateValid()) {
                    e.preventDefault();
                    return false;
                }
                if (!isAgeValid()) {
                    e.preventDefault();
                    return false;
                }
                if (!selectedTimeSlot.val()) {
                    e.preventDefault();
                    timeSlotError.show();
                    return false;
                }
                return true;
            });
        });
    </script>
    <style>
        .btn-timeslot {
            min-width: 90px;
            margin: 4px;
            font-weight: 600;
            font-size: .85rem;
            padding: .55rem 1rem;
            border-radius: var(--radius-sm);
            transition: all .15s;
        }

        .btn-timeslot-available {
            background: var(--gym-card);
            border: 1px solid var(--gym-border);
            color: var(--gym-text);
        }

            .btn-timeslot-available:hover {
                border-color: var(--gym-accent);
                color: var(--gym-accent);
                background: rgba(255, 107, 0, .08);
            }

        .btn-timeslot-selected {
            background: linear-gradient(135deg, var(--gym-accent), var(--gym-accent2));
            border: 1px solid var(--gym-accent);
            color: #fff;
            box-shadow: 0 4px 14px rgba(255, 107, 0, .35);
        }

        .btn-timeslot-booked, .btn-timeslot-booked:disabled {
            background: var(--gym-input);
            border: 1px solid var(--gym-border);
            color: var(--gym-muted);
            opacity: 1;
            cursor: not-allowed;
            text-decoration: line-through;
        }
    </style>
}