@model IEnumerable<GYM_MANAGEMENT_SYSTEM.ViewModels.BookingIndexViewModel>
@{
    ViewData["Title"] = "Quản lý đặt lịch";
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fitness-title">📅 Quản lý đặt lịch</h1>
            <p class="text-muted">Quản lý các buổi tập đã đặt</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Calendar" class="btn btn-fitness-secondary">
                <i class="fas fa-calendar-alt me-2"></i>Lịch biểu
            </a>
            <a asp-action="Create" class="btn btn-fitness-primary">
                <i class="fas fa-plus-circle me-2"></i>Đặt lịch mới
            </a>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Booking Cards -->
    @if (Model.Any())
    {
        <div class="row">
            @foreach (var booking in Model)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card-fitness">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start">
                                <div>
                                    <h4 class="text-white">
                                        <i class="fas fa-user-tie me-2" style="color: var(--orange-primary);"></i>
                                        @booking.TrainerName
                                    </h4>
                                    <span class="badge-fitness @booking.StatusBadgeClass">
                                        @booking.StatusDisplay
                                    </span>
                                </div>
                                <small class="text-muted">#@booking.Id</small>
                            </div>

                            <div class="mt-3">
                                <p class="text-muted" style="font-size: 0.9rem;">
                                    <i class="fas fa-calendar-day me-2" style="color: var(--orange-primary);"></i>
                                    <strong>Ngày:</strong> @booking.DateDisplay
                                </p>
                                <p class="text-muted" style="font-size: 0.9rem;">
                                    <i class="fas fa-clock me-2" style="color: var(--orange-primary);"></i>
                                    <strong>Giờ:</strong> @booking.TimeDisplay
                                </p>
                                @if (!string.IsNullOrEmpty(booking.Notes))
                                {
                                    <p class="text-muted" style="font-size: 0.85rem;">
                                        <i class="fas fa-align-left me-2" style="color: var(--orange-primary);"></i>
                                        <strong>Ghi chú:</strong> @booking.Notes
                                    </p>
                                }
                            </div>

                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <a asp-action="Details" asp-route-id="@booking.Id"
                                   class="btn btn-fitness-outline-light" style="flex:1; padding: 6px 12px; font-size: 0.85rem;">
                                    <i class="fas fa-eye me-1"></i>Chi tiết
                                </a>
                                @if (booking.Status == "Pending" || booking.Status == "Confirmed")
                                {
                                    <form asp-action="Cancel" asp-route-id="@booking.Id" method="post" style="flex:1;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-fitness-danger w-100"
                                                style="padding: 6px 12px; font-size: 0.85rem;"
                                                onclick="return confirm('Bạn có chắc muốn hủy đặt lịch này?')">
                                            <i class="fas fa-times me-1"></i>Hủy
                                        </button>
                                    </form>
                                }
                            </div>

                            <div class="mt-2">
                                <small class="text-muted">
                                    <i class="fas fa-calendar-alt me-1"></i>
                                    Đặt ngày: @booking.CreatedAt.ToString("dd/MM/yyyy HH:mm")
                                </small>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-calendar-plus" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h4 class="text-muted mt-3">Chưa có lịch đặt nào</h4>
            <p class="text-muted">Đặt lịch tập ngay hôm nay</p>
            <a asp-action="Create" class="btn btn-fitness-primary mt-3">
                <i class="fas fa-plus-circle me-2"></i>Đặt lịch ngay
            </a>
        </div>
    }

    <!-- Statistics -->
    @if (Model.Any())
    {
        <div class="row mt-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="fas fa-calendar-check"></i>
                    </div>
                    <div class="stat-number">@Model.Count()</div>
                    <div class="stat-label">Tổng số buổi</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon yellow">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number">@Model.Count(b => b.Status == "Pending" || b.Status == "Confirmed")</div>
                    <div class="stat-label">Đang chờ/xác nhận</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fas fa-check-circle"></i>
                    </div>
                    <div class="stat-number">@Model.Count(b => b.Status == "Completed")</div>
                    <div class="stat-label">Đã hoàn thành</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon red">
                        <i class="fas fa-times-circle"></i>
                    </div>
                    <div class="stat-number">@Model.Count(b => b.Status == "Cancelled")</div>
                    <div class="stat-label">Đã hủy</div>
                </div>
            </div>
        </div>
    }
</div>