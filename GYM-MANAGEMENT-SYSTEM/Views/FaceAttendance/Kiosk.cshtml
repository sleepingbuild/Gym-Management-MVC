@{
    ViewData["Title"] = "Kiosk Điểm Danh Khuôn Mặt";
    Layout = "_Layout";
}

<div class="container-fluid text-center mt-3">
    <h2 class="mb-3">📷 Kiosk Điểm Danh Khuôn Mặt</h2>

    <div id="statusBanner" class="alert alert-secondary" role="alert">
        Đang tải mô hình nhận diện...
    </div>

    <div class="position-relative d-inline-block">
        <video id="video" width="640" height="480" autoplay muted class="border rounded"></video>
        <canvas id="overlay" width="640" height="480" class="position-absolute top-0 start-0"></canvas>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
    <script>
        // Nếu CDN model bị chặn (chạy offline), tải thư mục weights về
        // wwwroot/lib/face-api/models rồi đổi MODEL_URL thành "/lib/face-api/models"
        const MODEL_URL = "https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights";
        const COOLDOWN_MS = 8000;       // tránh gọi API liên tục cho cùng 1 người

        const video = document.getElementById("video");
        const overlay = document.getElementById("overlay");
        const banner = document.getElementById("statusBanner");

        // Trình duyệt KHÔNG còn giữ danh sách khuôn mặt đã đăng ký nữa — chỉ gửi
        // vector vừa quét lên server, server tự so khớp với toàn bộ hồ sơ (1-N).
        // Cooldown TOÀN CỤC (không phân biệt theo người) — chặn NGAY TỪ TRƯỚC khi
        // gửi request, để tránh 1 người đứng trước camera vài giây bị quét đi
        // quét lại nhiều lần liên tiếp (trước đây cooldown chỉ chặn hiển thị banner,
        // không chặn gọi API, khiến 1 lần đứng lâu trước camera bị tính thành cả
        // check-in LẪN check-out chỉ trong vài giây).
        let cooldownUntil = 0;

        function setBanner(message, type) {
            banner.className = "alert alert-" + type;
            banner.textContent = message;
        }

        async function loadModels() {
            await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
            await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
            await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
        }

        async function startCamera() {
            const stream = await navigator.mediaDevices.getUserMedia({ video: {} });
            video.srcObject = stream;
        }

        async function sendScan(descriptor) {
            const res = await fetch("/FaceAttendance/CheckIn", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ descriptor: Array.from(descriptor) })
            });
            return await res.json();
        }

        function detectLoop() {
            const ctx = overlay.getContext("2d");
            let busy = false;

            setInterval(async () => {
                if (busy) return;
                if (Date.now() < cooldownUntil) return; // vừa xử lý xong, chờ trước khi quét tiếp

                // QUAN TRỌNG: set busy=true NGAY TỪ ĐẦU, trước cả bước detectSingleFace
                // (bước này bất đồng bộ, có thể mất vài trăm ms). Nếu để busy=true sau
                // bước nhận diện, tick tiếp theo của setInterval có thể lọt qua kiểm tra
                // "if (busy) return" trong lúc tick hiện tại vẫn đang nhận diện dở dang
                // -> gây gửi trùng 2 lần gần như đồng thời (race condition).
                busy = true;

                try {
                    const detection = await faceapi
                        .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                        .withFaceLandmarks()
                        .withFaceDescriptor();

                    ctx.clearRect(0, 0, overlay.width, overlay.height);

                    if (!detection) {
                        return; // vào finally, busy=false, không gửi gì cả
                    }

                    const box = detection.detection.box;
                    ctx.strokeStyle = "#00c853";
                    ctx.lineWidth = 2;
                    ctx.strokeRect(box.x, box.y, box.width, box.height);

                    setBanner("Đang nhận diện khuôn mặt...", "info");

                    const result = await sendScan(detection.descriptor);

                    if (!result.success && !result.fullName) {
                        // Không nhận dạng được ai cả — không cần cooldown, cho quét lại ngay
                        setBanner("Không nhận diện được — chưa đăng ký khuôn mặt hoặc không đủ rõ.", "secondary");
                    } else {
                        // Đã xác định được là ai (thành công hay không) -> bắt đầu cooldown
                        // để không gửi lại liên tục trong lúc người này vẫn còn trước camera.
                        cooldownUntil = Date.now() + COOLDOWN_MS;

                        if (result.success) {
                            const icon = result.action === "CheckOut" ? "👋" : "✅";
                            setBanner(`${icon} ${result.message} — ${result.fullName} (${result.role})`, "success");
                        } else {
                            setBanner(`⚠️ ${result.message}${result.fullName ? " — " + result.fullName : ""}`, "warning");
                        }
                    }
                } catch (err) {
                    console.error(err);
                    setBanner("Lỗi khi gửi dữ liệu điểm danh: " + err.message, "danger");
                } finally {
                    busy = false;
                }
            }, 1200);
        }

        (async function init() {
            try {
                await loadModels();
                await startCamera();
                setBanner("Sẵn sàng. Đưa khuôn mặt vào khung hình để điểm danh.", "primary");
                detectLoop();
            } catch (err) {
                console.error(err);
                setBanner("Lỗi khởi tạo Kiosk: " + err.message, "danger");
            }
        })();
    </script>
}
