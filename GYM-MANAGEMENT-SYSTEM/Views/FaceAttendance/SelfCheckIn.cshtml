@{
    ViewData["Title"] = "Điểm danh bằng khuôn mặt";
    Layout = "_Layout";
    var hasFaceProfile = (bool)(ViewBag.HasFaceProfile ?? false);
}

<div class="container mt-4 text-center">
    <h2 class="mb-3">🙋 Điểm danh bằng khuôn mặt</h2>

    @if (!hasFaceProfile)
    {
        <div class="alert alert-warning">
            Bạn chưa được đăng ký khuôn mặt trong hệ thống. Vui lòng liên hệ Admin để đăng ký trước khi dùng tính năng này.
        </div>
    }
    else
    {
        <div id="statusBanner" class="alert alert-secondary">Đang tải mô hình nhận diện...</div>

        <div class="position-relative d-inline-block">
            <video id="video" width="480" height="360" autoplay muted class="border rounded"></video>
            <canvas id="overlay" width="480" height="360" class="position-absolute top-0 start-0"></canvas>
        </div>

        <p class="text-muted mt-2">Đưa khuôn mặt vào giữa khung hình và giữ yên vài giây. Hệ thống chỉ chấp nhận đúng khuôn mặt đã đăng ký cho tài khoản này.</p>
    }
</div>

@if (hasFaceProfile)
{
    @section Scripts {
        <script src="https://cdn.jsdelivr.net/npm/face-api.js@0.22.2/dist/face-api.min.js"></script>
        <script>
            const MODEL_URL = "https://cdn.jsdelivr.net/gh/justadudewhohacks/face-api.js@master/weights";

            const video = document.getElementById("video");
            const overlay = document.getElementById("overlay");
            const banner = document.getElementById("statusBanner");

            let scanCompleted = false; // đã điểm danh xong trong phiên xem trang này

            function setBanner(message, type) {
                banner.className = "alert alert-" + type;
                banner.textContent = message;
            }

            async function loadModels() {
                await faceapi.nets.tinyFaceDetector.loadFromUri(MODEL_URL);
                await faceapi.nets.faceLandmark68Net.loadFromUri(MODEL_URL);
                await faceapi.nets.faceRecognitionNet.loadFromUri(MODEL_URL);
            }

            async function startCamera() {
                const stream = await navigator.mediaDevices.getUserMedia({ video: {} });
                video.srcObject = stream;
            }

            // Gửi thẳng vector vừa quét lên server — server tự so khớp (1-1) với
            // ĐÚNG hồ sơ của tài khoản đang đăng nhập, không tin kết quả tự so ở
            // trình duyệt nữa.
            async function submitScan(descriptor) {
                const res = await fetch("/FaceAttendance/SelfCheckInSubmit", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ descriptor: Array.from(descriptor) })
                });
                return await res.json();
            }

            function detectLoop() {
                const ctx = overlay.getContext("2d");
                let busy = false;

                setInterval(async () => {
                    if (scanCompleted || busy) return;

                    // QUAN TRỌNG: set busy=true NGAY TỪ ĐẦU, trước cả bước detectSingleFace
                    // (bất đồng bộ, có thể mất vài trăm ms) — tránh tick tiếp theo của
                    // setInterval lọt qua kiểm tra "if (busy) return" trong lúc tick hiện
                    // tại vẫn đang nhận diện dở dang, gây gửi trùng 2 lần liên tiếp.
                    busy = true;

                    try {
                        const detection = await faceapi
                            .detectSingleFace(video, new faceapi.TinyFaceDetectorOptions())
                            .withFaceLandmarks()
                            .withFaceDescriptor();

                        ctx.clearRect(0, 0, overlay.width, overlay.height);
                        if (!detection) return; // vào finally, busy=false, không gửi gì cả

                        const box = detection.detection.box;
                        ctx.strokeStyle = "#00c853";
                        ctx.lineWidth = 2;
                        ctx.strokeRect(box.x, box.y, box.width, box.height);

                        setBanner("Đang xác thực khuôn mặt...", "info");

                        const result = await submitScan(detection.descriptor);

                        if (result.success) {
                            scanCompleted = true;
                            const icon = result.action === "CheckOut" ? "👋" : "✅";
                            setBanner(`${icon} ${result.message}`, "success");
                        } else {
                            // Không khớp mặt hoặc không còn gì để điểm danh — cho thử lại,
                            // không khóa hẳn (trừ khi rõ ràng đã xong cả check-in lẫn check-out).
                            setBanner(`⚠️ ${result.message}`, "warning");
                        }
                    } catch (err) {
                        console.error(err);
                        setBanner("Lỗi khi gửi dữ liệu điểm danh: " + err.message, "danger");
                    } finally {
                        busy = false;
                    }
                }, 1200);
            }

            (async function init() {
                try {
                    await loadModels();
                    await startCamera();
                    setBanner("Sẵn sàng. Đưa mặt vào khung hình để điểm danh.", "primary");
                    detectLoop();
                } catch (err) {
                    console.error(err);
                    setBanner("Lỗi: " + err.message, "danger");
                }
            })();
        </script>
    }
}
