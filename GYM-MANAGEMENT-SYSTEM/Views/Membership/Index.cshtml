@model List<GYM_MANAGEMENT_SYSTEM.ViewModels.UserMembershipViewModel>
@{
    ViewData["Title"] = "Gói tập của tôi";
    bool canRegister = ViewBag.HasActive ?? true;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
                <div>
                    <h1 class="fitness-title mb-1">💪 Gói tập của tôi</h1>
                    <p class="text-muted mb-0">Quản lý gói tập đang sử dụng và lịch sử đăng ký</p>
                </div>
                @if (canRegister)
                {
                    <a asp-action="Register" class="btn btn-fitness-primary">
                        <i class="fas fa-plus-circle me-2"></i>Đăng ký gói mới
                    </a>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mb-4"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mb-4"><i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div>
            }

            @if (!canRegister)
            {
                <div class="alert alert-info mb-4">
                    <i class="fas fa-info-circle me-2"></i>
                    Bạn đang có một gói tập chờ thanh toán. Hoàn tất thanh toán hoặc hủy gói đó trước khi đăng ký gói mới.
                </div>
            }

            @if (Model == null || !Model.Any())
            {
                <div class="card-fitness">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-box-open mb-3" style="font-size:2.5rem;color:var(--gym-border)"></i>
                        <p class="text-muted mb-3">Bạn chưa đăng ký gói tập nào.</p>
                        <a asp-action="Register" class="btn btn-fitness-primary">
                            <i class="fas fa-plus-circle me-2"></i>Đăng ký ngay
                        </a>
                    </div>
                </div>
            }
            else
            {
                @foreach (var m in Model)
                {
                    <div class="card-fitness mb-3">
                        <div class="card-header d-flex justify-content-between align-items-center">
                            <span><i class="fas fa-box me-2"></i>@m.PackageName</span>
                            <span class="@m.StatusBadgeClass">@m.StatusDisplay</span>
                        </div>
                        <div class="card-body">
                            @if (m.IsPending)
                            {
                                <div class="alert alert-warning mb-3">
                                    <i class="fas fa-clock me-2"></i>
                                    Gói này chưa được thanh toán nên chưa thể sử dụng. Hoàn tất thanh toán để kích hoạt.
                                </div>
                            }
                            <dl class="row mb-3">
                                <dt class="col-sm-4 text-muted">Giá</dt>
                                <dd class="col-sm-8">@m.PriceFormatted</dd>

                                <dt class="col-sm-4 text-muted">Thời hạn</dt>
                                <dd class="col-sm-8">@m.DurationDisplay</dd>

                                @if (!m.IsPending)
                                {
                                    <dt class="col-sm-4 text-muted">Ngày bắt đầu</dt>
                                    <dd class="col-sm-8">@m.StartDate.ToString("dd/MM/yyyy")</dd>

                                    <dt class="col-sm-4 text-muted">Ngày hết hạn</dt>
                                    <dd class="col-sm-8">@m.EndDate.ToString("dd/MM/yyyy")</dd>
                                }

                                @if (m.IsActive)
                                {
                                    <dt class="col-sm-4 text-muted">Còn lại</dt>
                                    <dd class="col-sm-8 mb-0">@m.DaysRemainingDisplay</dd>
                                }
                            </dl>

                            <div class="d-flex gap-2">
                                @if (m.IsPending)
                                {
                                    <a asp-controller="Payment" asp-action="Create" asp-route-membershipId="@m.Id" class="btn btn-fitness-primary btn-sm">
                                        <i class="fas fa-credit-card me-2"></i>Thanh toán ngay
                                    </a>
                                }
                                @if (m.IsActive || m.IsExpired)
                                {
                                    <a asp-action="Renew" asp-route-id="@m.Id" class="btn btn-fitness-secondary btn-sm">
                                        <i class="fas fa-redo me-2"></i>Gia hạn
                                    </a>
                                }
                                @if (m.IsActive || m.IsPending)
                                {
                                    <form asp-action="Cancel" asp-route-id="@m.Id" method="post"
                                          onsubmit="return confirm('Bạn chắc chắn muốn hủy gói tập này?');">
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            <i class="fas fa-times me-2"></i>Hủy gói
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                }
            }
        </div>
    </div>
</div>
