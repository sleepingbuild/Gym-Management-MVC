@{
    ViewData["Title"] = "Đăng ký gói tập";
    var packages = ViewBag.Packages as IEnumerable<GYM_MANAGEMENT_SYSTEM.Models.MembershipPackage>;
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fitness-title">🎯 Đăng ký gói tập</h1>
            <p class="text-muted">Chọn gói tập phù hợp với bạn</p>
        </div>
        <a asp-action="Index" class="btn btn-fitness-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (packages != null && packages.Any())
    {
        <div class="row">
            @foreach (var package in packages)
            {
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="pricing-card">
                        <div class="pricing-name">@package.Name</div>
                        <div class="pricing-price">
                            @string.Format("{0:N0} VNĐ", package.Price)
                            <span>/ @(package.DurationDays >= 30 ? $"{package.DurationDays / 30} tháng" : $"{package.DurationDays} ngày")</span>
                        </div>
                        <p class="text-muted" style="min-height: 60px;">@package.Description</p>

                        <ul class="pricing-features">
                            <li>
                                <i class="fas fa-calendar-day"></i>
                                <span>
                                    Thời hạn: <strong>@(package.DurationDays >= 30 ? $"{package.DurationDays / 30} tháng" : $"{package.DurationDays} ngày")</strong>
                                </span>
                            </li>
                            <li>
                                <i class="fas fa-tag"></i>
                                <span>Giá: <strong>@string.Format("{0:N0} VNĐ", package.Price)</strong></span>
                            </li>
                        </ul>

                        <form asp-action="Register" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="packageId" value="@package.Id" />
                            <button type="submit" class="btn btn-fitness-primary w-100">
                                <i class="fas fa-check-circle me-2"></i>Đăng ký ngay
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-box-open" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h4 class="text-muted mt-3">Hiện chưa có gói tập nào</h4>
            <p class="text-muted">Vui lòng quay lại sau</p>
            <a asp-action="Index" class="btn btn-fitness-primary mt-3">
                <i class="fas fa-arrow-left me-2"></i>Quay lại
            </a>
        </div>
    }
</div>