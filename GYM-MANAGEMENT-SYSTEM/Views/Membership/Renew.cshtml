@model GYM_MANAGEMENT_SYSTEM.ViewModels.RenewalInfoViewModel
@{
    ViewData["Title"] = "Gia hạn gói tập";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-sync me-2"></i>Gia hạn gói tập
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-ticket-alt" style="font-size: 3rem; color: var(--orange-primary);"></i>
                        <h4 class="mt-3">@Model.PackageName</h4>
                        <span class="badge-fitness @Model.StatusBadgeClass">@Model.StatusDisplay</span>
                    </div>

                    <div class="row mb-4">
                        <div class="col-6">
                            <small class="text-muted">Ngày hết hạn hiện tại</small>
                            <p class="fw-bold">@Model.CurrentEndDateDisplay</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Ngày hết hạn mới</small>
                            <p class="fw-bold" style="color: var(--success-green);">@Model.NewEndDateDisplay</p>
                        </div>
                    </div>

                    <div class="alert alert-info mb-4">
                        <i class="fas fa-info-circle me-2"></i>
                        <span>Gia hạn thêm <strong>@Model.DurationDisplay</strong> với giá <strong>@Model.PriceFormatted</strong></span>
                    </div>

                    @if (Model.DaysUntilExpiry > 7)
                    {
                        <div class="alert alert-warning mb-4">
                            <i class="fas fa-clock me-2"></i>
                            <span>Gói tập của bạn còn <strong>@Model.DaysUntilExpiry</strong> ngày. Bạn có thể gia hạn bất cứ lúc nào.</span>
                        </div>
                    }
                    else if (Model.DaysUntilExpiry >= 0 && Model.DaysUntilExpiry <= 7)
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="fas fa-exclamation-triangle me-2"></i>
                            <span>Gói tập của bạn sắp hết hạn! Chỉ còn <strong>@Model.DaysUntilExpiry</strong> ngày. Hãy gia hạn ngay.</span>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-danger mb-4">
                            <i class="fas fa-times-circle me-2"></i>
                            <span>Gói tập của bạn đã hết hạn. Hãy gia hạn để tiếp tục tập luyện.</span>
                        </div>
                    }

                    <form asp-action="RenewConfirm" method="post">
                        <input type="hidden" name="id" value="@Model.MembershipId" />
                        @Html.AntiForgeryToken()

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fitness-success flex-grow-1">
                                <i class="fas fa-credit-card me-2"></i>Xác nhận & Thanh toán
                            </button>
                            <a asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>