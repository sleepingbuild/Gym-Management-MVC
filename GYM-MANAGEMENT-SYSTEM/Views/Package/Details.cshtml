@model GYM_MANAGEMENT_SYSTEM.ViewModels.PackageIndexViewModel
@{
    var isAdmin = User.IsInRole("Admin");
    ViewData["Title"] = "Chi tiết gói tập";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-info-circle me-2"></i>Chi tiết gói tập
                </div>
                <div class="card-body">
                    <dl class="row">
                        <dt class="col-sm-3 text-muted">Tên gói tập</dt>
                        <dd class="col-sm-9 fw-bold">@Model.Name</dd>

                        <dt class="col-sm-3 text-muted">Mô tả</dt>
                        <dd class="col-sm-9">@Model.Description</dd>

                        <dt class="col-sm-3 text-muted">Giá</dt>
                        <dd class="col-sm-9 fw-bold" style="color: var(--orange-primary);">
                            @Model.PriceFormatted
                        </dd>

                        <dt class="col-sm-3 text-muted">Thời hạn</dt>
                        <dd class="col-sm-9">@Model.DurationDisplay</dd>

                        @if (isAdmin)
                        {
                            <dt class="col-sm-3 text-muted">Trạng thái</dt>
                            <dd class="col-sm-9">
                                <span class="badge-fitness @(Model.IsActive ? "green" : "red")">
                                    @Model.StatusText
                                </span>
                            </dd>

                            <dt class="col-sm-3 text-muted">Ngày tạo</dt>
                            <dd class="col-sm-9">@Model.CreatedAt.ToString("dd/MM/yyyy HH:mm")</dd>
                        }
                    </dl>

                    <div class="d-flex gap-2 mt-3">
                        @if (isAdmin)
                        {
                            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-fitness-primary">
                                <i class="fas fa-edit me-2"></i>Sửa
                            </a>
                        }
                        else if (Model.IsActive)
                        {
                            <a asp-controller="Membership" asp-action="Register" class="btn btn-fitness-primary">
                                <i class="fas fa-check-circle me-2"></i>Đăng ký gói này
                            </a>
                        }
                        <a asp-action="Index" class="btn btn-fitness-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
