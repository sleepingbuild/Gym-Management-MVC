@model GYM_MANAGEMENT_SYSTEM.ViewModels.PaymentCreateViewModel
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-credit-card me-2"></i>Xác nhận thanh toán
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <i class="fas fa-shield-alt" style="font-size: 4rem; color: var(--orange-primary);"></i>
                        <h4 class="text-white mt-3">Xác nhận thanh toán gói tập</h4>
                        <p class="text-muted">Kiểm tra lại số tiền rồi bấm xác nhận để hoàn tất</p>
                    </div>

                    <div class="alert alert-info mb-4">
                        <div class="d-flex justify-content-between">
                            <span class="text-muted">Số tiền cần thanh toán</span>
                            <span class="fw-bold" style="color: var(--orange-primary); font-size: 1.5rem;">
                                @string.Format("{0:N0} VNĐ", Model.Amount)
                            </span>
                        </div>
                    </div>

                    <div class="mb-4">
                        <p class="text-muted small">
                            <i class="fas fa-check-circle me-2"></i>
                            Gói tập sẽ được kích hoạt/gia hạn ngay sau khi xác nhận
                        </p>
                    </div>

                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="UserId" />
                        <input type="hidden" asp-for="MembershipId" />
                        <input type="hidden" asp-for="Amount" />
                        <input type="hidden" asp-for="Method" />
                        <input type="hidden" asp-for="PaymentInfo" />

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fitness-primary flex-grow-1">
                                <i class="fas fa-check-circle me-2"></i>Xác nhận thanh toán
                            </button>
                            <a asp-controller="Membership" asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>