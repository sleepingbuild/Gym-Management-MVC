@model GYM_MANAGEMENT_SYSTEM.ViewModels.PaymentIndexViewModel
@{
    ViewData["Title"] = "Chi tiết thanh toán";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-info-circle me-2"></i>Chi tiết thanh toán
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="auth-icon" style="width: 100px; height: 100px; margin: 0 auto;">
                            <i class="fas fa-credit-card" style="font-size: 3rem;"></i>
                        </div>
                        <h3 class="text-white mt-3">Giao dịch #@Model.Id</h3>
                        <span class="badge-fitness @Model.StatusBadgeClass">
                            @Model.StatusDisplay
                        </span>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Số tiền</small>
                            <p class="fw-bold" style="color: var(--orange-primary);">@Model.AmountDisplay</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Phương thức</small>
                            <p class="fw-bold">@Model.MethodDisplay</p>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-6">
                            <small class="text-muted">Mã giao dịch</small>
                            <p class="fw-bold">@(string.IsNullOrEmpty(Model.TransactionId) ? "-" : Model.TransactionId)</p>
                        </div>
                        <div class="col-6">
                            <small class="text-muted">Ngày giao dịch</small>
                            <p class="fw-bold">@Model.DateDisplay</p>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.PaymentInfo))
                    {
                        <div class="mt-3">
                            <small class="text-muted">Thông tin</small>
                            <p class="fw-bold">@Model.PaymentInfo</p>
                        </div>
                    }

                    <div class="d-flex gap-2 mt-4">
                        <a asp-action="Index" class="btn btn-fitness-secondary">
                            <i class="fas fa-arrow-left me-2"></i>Quay lại
                        </a>
                        @if (Model.Status == "Pending")
                        {
                            <a asp-action="Create" asp-route-membershipId="@Model.MembershipId"
                               class="btn btn-fitness-primary">
                                <i class="fas fa-sync me-2"></i>Thử lại
                            </a>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>