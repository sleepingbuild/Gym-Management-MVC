@model IEnumerable<GYM_MANAGEMENT_SYSTEM.ViewModels.PaymentIndexViewModel>
@{
    ViewData["Title"] = "Thanh toán";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fitness-title">💳 Thanh toán</h1>
            <p class="text-muted">Quản lý các giao dịch thanh toán của bạn</p>
        </div>
        <a asp-action="History" class="btn btn-fitness-secondary">
            <i class="fas fa-history me-2"></i>Lịch sử
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-fitness">
                <thead>
                    <tr>
                        <th>Mã GD</th>
                        <th>Số tiền</th>
                        <th>Phương thức</th>
                        <th>Trạng thái</th>
                        <th>Ngày</th>
                        <th>Thao tác</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var payment in Model)
                    {
                        <tr>
                            <td>#@payment.Id</td>
                            <td class="fw-bold">@payment.AmountDisplay</td>
                            <td>@payment.MethodDisplay</td>
                            <td>
                                <span class="badge-fitness @payment.StatusBadgeClass">
                                    @payment.StatusDisplay
                                </span>
                            </td>
                            <td>@payment.DateDisplay</td>
                            <td>
                                <a asp-action="Details" asp-route-id="@payment.Id" 
                                   class="btn btn-sm btn-fitness-outline-light">
                                    <i class="fas fa-eye"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-credit-card" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h4 class="text-muted mt-3">Chưa có giao dịch nào</h4>
            <p class="text-muted">Bắt đầu thanh toán khi đăng ký gói tập</p>
            <a asp-controller="Membership" asp-action="Register" class="btn btn-fitness-primary mt-3">
                <i class="fas fa-plus-circle me-2"></i>Đăng ký ngay
            </a>
        </div>
    }
</div>