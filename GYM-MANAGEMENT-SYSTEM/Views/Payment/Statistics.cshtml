@model GYM_MANAGEMENT_SYSTEM.ViewModels.PaymentStatisticsViewModel
@{
    ViewData["Title"] = "Thống kê thanh toán";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fitness-title">📊 Thống kê thanh toán</h1>
            <p class="text-muted">Tổng quan về các giao dịch của bạn</p>
        </div>
        <a asp-action="History" class="btn btn-fitness-secondary">
            <i class="fas fa-arrow-left me-2"></i>Quay lại
        </a>
    </div>

    @if (Model.TotalPayments > 0)
    {
        <!-- Summary -->
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="fas fa-coins"></i>
                    </div>
                    <div class="stat-number">@Model.TotalSuccessAmountDisplay</div>
                    <div class="stat-label">Tổng tiền đã thanh toán</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fas fa-list"></i>
                    </div>
                    <div class="stat-number">@Model.TotalPayments</div>
                    <div class="stat-label">Tổng giao dịch</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fas fa-percent"></i>
                    </div>
                    <div class="stat-number">@Model.SuccessRateDisplay</div>
                    <div class="stat-label">Tỷ lệ thành công</div>
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon yellow">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number">@Model.PendingCount</div>
                    <div class="stat-label">Đang xử lý</div>
                </div>
            </div>
        </div>

        <!-- Status Breakdown -->
        <div class="row">
            <div class="col-md-6 mb-4">
                <div class="card-fitness">
                    <div class="card-header">
                        <i class="fas fa-chart-pie me-2"></i>Phân bố trạng thái
                    </div>
                    <div class="card-body">
                        <div class="d-flex justify-content-between py-2 border-bottom border-dark">
                            <span class="text-muted">
                                <i class="fas fa-check-circle me-2" style="color: var(--success-green);"></i>
                                Thành công
                            </span>
                            <span class="fw-bold" style="color: var(--success-green);">
                                @Model.SuccessCount
                            </span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom border-dark">
                            <span class="text-muted">
                                <i class="fas fa-clock me-2" style="color: var(--warning-yellow);"></i>
                                Đang xử lý
                            </span>
                            <span class="fw-bold" style="color: var(--warning-yellow);">
                                @Model.PendingCount
                            </span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted">
                                <i class="fas fa-times-circle me-2" style="color: var(--error-red);"></i>
                                Thất bại
                            </span>
                            <span class="fw-bold" style="color: var(--error-red);">
                                @Model.FailedCount
                            </span>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-md-6 mb-4">
                <div class="card-fitness">
                    <div class="card-header">
                        <i class="fas fa-history me-2"></i>5 giao dịch gần đây
                    </div>
                    <div class="card-body">
                        @if (Model.RecentPayments.Any())
                        {
                            <ul class="list-unstyled">
                                @foreach (var item in Model.RecentPayments)
                                {
                                    <li class="d-flex justify-content-between align-items-center py-2 border-bottom border-dark">
                                        <div>
                                            <strong>@item.AmountDisplay</strong>
                                            <br />
                                            <small class="text-muted">@item.DateDisplay</small>
                                        </div>
                                        <div>
                                            <span class="badge-fitness @item.StatusBadgeClass me-2">
                                                @item.Status
                                            </span>
                                            <span class="text-muted small">@item.MethodDisplay</span>
                                        </div>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p class="text-muted text-center">Chưa có giao dịch nào</p>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-chart-pie" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h4 class="text-muted mt-3">Chưa có dữ liệu thống kê</h4>
            <p class="text-muted">Hãy thực hiện thanh toán để xem thống kê</p>
            <a asp-controller="Membership" asp-action="Register" class="btn btn-fitness-primary mt-3">
                <i class="fas fa-plus-circle me-2"></i>Đăng ký ngay
            </a>
        </div>
    }
</div>