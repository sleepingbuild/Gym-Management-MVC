@model GYM_MANAGEMENT_SYSTEM.ViewModels.MyMembershipViewModel?
@{
    ViewData["Title"] = "Thẻ tập của tôi";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="text-center mb-4">
                <h1 class="fitness-title mb-1">🎫 Thẻ tập của tôi</h1>
                <p class="text-muted mb-0">Gói tập bạn đang sử dụng</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mb-4"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mb-4"><i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div>
            }

            @if (Model == null)
            {
                <div class="card-fitness">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-id-card mb-3" style="font-size:2.5rem;color:var(--gym-border)"></i>
                        <p class="text-muted mb-3">Bạn chưa có gói tập nào đang sử dụng.</p>
                        <a asp-controller="Membership" asp-action="Register" class="btn btn-fitness-primary">
                            <i class="fas fa-plus-circle me-2"></i>Đăng ký gói tập
                        </a>
                    </div>
                </div>
            }
            else
            {
                <div class="card-fitness">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-box me-2"></i>@Model.PackageName</span>
                        <span class="@Model.StatusBadgeClass">@Model.StatusDisplay</span>
                    </div>
                    <div class="card-body">
                        @if (Model.Status == "Pending")
                        {
                            <div class="alert alert-warning mb-3">
                                <i class="fas fa-clock me-2"></i>
                                Gói này chưa được thanh toán nên chưa thể sử dụng.
                            </div>
                        }
                        else
                        {
                            <div class="text-center mb-4">
                                <div class="display-4 fw-bold" style="color:@(Model.DaysRemaining > 0 ? "var(--success-green)" : "var(--gym-danger)")">
                                    @(Model.DaysRemaining > 0 ? Model.DaysRemaining.ToString() : "0")
                                </div>
                                <div class="text-muted">@(Model.DaysRemaining > 0 ? "ngày còn lại" : "Đã hết hạn")</div>
                            </div>
                        }

                        @if (!string.IsNullOrWhiteSpace(Model.PackageDescription))
                        {
                            <p class="text-muted mb-3">@Model.PackageDescription</p>
                        }

                        <dl class="row mb-3">
                            <dt class="col-sm-4 text-muted">Giá</dt>
                            <dd class="col-sm-8">@Model.PriceFormatted</dd>

                            <dt class="col-sm-4 text-muted">Thời hạn</dt>
                            <dd class="col-sm-8">@Model.DurationDays ngày</dd>

                            @if (Model.Status != "Pending")
                            {
                                <dt class="col-sm-4 text-muted">Ngày bắt đầu</dt>
                                <dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

                                <dt class="col-sm-4 text-muted">Ngày hết hạn</dt>
                                <dd class="col-sm-8 mb-0">@Model.EndDate.ToString("dd/MM/yyyy")</dd>
                            }
                        </dl>

                        <div class="d-flex gap-2">
                            @if (Model.Status == "Pending")
                            {
                                <a asp-controller="Payment" asp-action="Create" asp-route-membershipId="@Model.Id" class="btn btn-fitness-primary flex-grow-1">
                                    <i class="fas fa-credit-card me-2"></i>Thanh toán ngay
                                </a>
                            }
                            else
                            {
                                <a asp-controller="Membership" asp-action="Renew" asp-route-id="@Model.Id" class="btn btn-fitness-secondary flex-grow-1">
                                    <i class="fas fa-redo me-2"></i>Gia hạn
                                </a>
                            }
                            <a asp-controller="Membership" asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-history me-2"></i>Lịch sử gói tập
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</div>
