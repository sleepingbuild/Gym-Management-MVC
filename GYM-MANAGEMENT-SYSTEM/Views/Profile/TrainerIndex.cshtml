@model GYM_MANAGEMENT_SYSTEM.Models.Trainer
@{
    ViewData["Title"] = "Thông tin huấn luyện viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h1 class="fitness-title">🧑‍🏫 Thông tin của tôi</h1>
                @if (Model != null)
                {
                    <a asp-action="Edit" class="btn btn-fitness-primary">
                        <i class="fas fa-edit me-2"></i>Sửa
                    </a>
                }
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success mb-4">
                    <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
                </div>
            }

            <div class="text-center mb-4">
                @if (Model != null && !string.IsNullOrEmpty(Model.AvatarPath))
                {
                    <img src="@Model.AvatarPath" alt="Ảnh đại diện"
                         style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:2px solid var(--gym-border);margin:0 auto;display:block;" />
                }
                else
                {
                    <div class="auth-icon" style="width: 100px; height: 100px; margin: 0 auto;">
                        <i class="fas fa-user-tie" style="font-size: 3rem;"></i>
                    </div>
                }
            </div>

            @if (Model == null)
            {
                <div class="card-fitness">
                    <div class="card-body text-center py-5">
                        <i class="fas fa-exclamation-circle mb-3" style="font-size:2.5rem;color:var(--gym-border)"></i>
                        <p class="text-muted mb-0">Không tìm thấy hồ sơ huấn luyện viên gắn với tài khoản này. Vui lòng liên hệ Admin.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card-fitness">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <span><i class="fas fa-id-card me-2"></i>Hồ sơ nghề nghiệp</span>
                        <span class="badge @(Model.IsAvailable ? "bg-success" : "bg-secondary")">
                            @(Model.IsAvailable ? "Đang hoạt động" : "Tạm nghỉ")
                        </span>
                    </div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4 text-muted">Họ và tên</dt>
                            <dd class="col-sm-8">@Model.FullName</dd>

                            <dt class="col-sm-4 text-muted">Chuyên môn</dt>
                            <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.Specialization) ? "—" : Model.Specialization)</dd>

                            <dt class="col-sm-4 text-muted">Số điện thoại</dt>
                            <dd class="col-sm-8">@Model.Phone</dd>

                            <dt class="col-sm-4 text-muted">Email</dt>
                            <dd class="col-sm-8">@Model.Email</dd>

                            <dt class="col-sm-4 text-muted">Tiểu sử</dt>
                            <dd class="col-sm-8 mb-0">@(string.IsNullOrWhiteSpace(Model.Bio) ? "—" : Model.Bio)</dd>
                        </dl>
                    </div>
                </div>
                <p class="text-muted small mt-3">
                    <i class="fas fa-info-circle me-1"></i>
                    Email, ngày sinh và trạng thái hoạt động do Admin quản lý. Bạn có thể tự cập nhật tên, chuyên môn, tiểu sử, số điện thoại và ảnh đại diện.
                </p>
            }
        </div>
    </div>
</div>
