@model GYM_MANAGEMENT_SYSTEM.ViewModels.AdminBookingCreateViewModel
@{
    ViewData["Title"] = "Đặt lịch hộ thành viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-calendar-plus me-2"></i>Đặt lịch hộ thành viên
                </div>
                <div class="card-body">
                    <p class="text-muted small mb-3">
                        Buổi tập tạo ra sẽ ở trạng thái <strong>Đã xác nhận</strong> ngay, không cần huấn luyện viên xác nhận lại.
                        Khung giờ sẽ tự cập nhật theo đúng ca làm việc của huấn luyện viên được chọn.
                    </p>

                    <form asp-action="Create" method="post" id="adminBookingForm">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="UserId" class="form-label">
                                <i class="fas fa-user me-2"></i>Thành viên
                            </label>
                            <select asp-for="UserId" class="form-select">
                                <option value="">-- Chọn thành viên --</option>
                                @foreach (var member in (IEnumerable<GYM_MANAGEMENT_SYSTEM.ViewModels.BookableMemberViewModel>)ViewBag.Members)
                                {
                                    <option value="@member.UserId">@member.FullName (@member.Email)</option>
                                }
                            </select>
                            <span asp-validation-for="UserId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TrainerId" class="form-label">
                                <i class="fas fa-user-tie me-2"></i>Huấn luyện viên
                            </label>
                            <select asp-for="TrainerId" class="form-select" id="trainerSelect">
                                <option value="">-- Chọn huấn luyện viên --</option>
                                @foreach (var trainer in (IEnumerable<dynamic>)ViewBag.Trainers)
                                {
                                    <option value="@trainer.Id">@trainer.FullName</option>
                                }
                            </select>
                            <span asp-validation-for="TrainerId" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="SessionDate" class="form-label">
                                    <i class="fas fa-calendar-day me-2"></i>Ngày tập
                                </label>
                                <input asp-for="SessionDate" type="date" class="form-control" min="@DateTime.Today.ToString("yyyy-MM-dd")" />
                                <span asp-validation-for="SessionDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="TimeSlot" class="form-label">
                                    <i class="fas fa-clock me-2"></i>Khung giờ
                                </label>
                                <select asp-for="TimeSlot" class="form-select" id="timeSlotSelect">
                                    <option value="">-- Chọn huấn luyện viên trước --</option>
                                    @foreach (var slot in (IEnumerable<string>)ViewBag.TimeSlots)
                                    {
                                        <option value="@slot">@slot</option>
                                    }
                                </select>
                                <span asp-validation-for="TimeSlot" class="text-danger small"></span>
                                <div id="shiftHint" class="small mt-1" style="color: var(--gym-muted);"></div>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">
                                <i class="fas fa-align-left me-2"></i>Ghi chú
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="2" placeholder="Ghi chú thêm (không bắt buộc)..."></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fitness-primary flex-grow-1">
                                <i class="fas fa-save me-2"></i>Đặt lịch
                            </button>
                            <a asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function() {
            var trainerSelect = $('#trainerSelect');
            var timeSlotSelect = $('#timeSlotSelect');
            var shiftHint = $('#shiftHint');

            function loadTrainerSlots() {
                var trainerId = trainerSelect.val();
                var currentValue = timeSlotSelect.val();

                if (!trainerId) {
                    timeSlotSelect.html('<option value="">-- Chọn huấn luyện viên trước --</option>');
                    shiftHint.text('');
                    return;
                }

                $.getJSON('@Url.Action("GetTrainerSlots")', { trainerId: trainerId }, function(slots) {
                    timeSlotSelect.empty();
                    timeSlotSelect.append('<option value="">-- Chọn khung giờ --</option>');

                    $.each(slots, function(i, slot) {
                        timeSlotSelect.append($('<option>').val(slot).text(slot));
                    });

                    if (slots.indexOf(currentValue) !== -1) {
                        timeSlotSelect.val(currentValue);
                    }

                    if (slots.length > 0) {
                        shiftHint.html('<i class="fas fa-business-time me-1"></i>Ca làm việc: <strong>' + slots[0] + ' - ' + addOneHour(slots[slots.length - 1]) + '</strong>');
                    } else {
                        shiftHint.text('Huấn luyện viên này chưa có khung giờ khả dụng.');
                    }
                }).fail(function() {
                    timeSlotSelect.html('<option value="">-- Không tải được khung giờ --</option>');
                });
            }

            function addOneHour(hhmm) {
                var parts = hhmm.split(':');
                var hour = (parseInt(parts[0], 10) + 1) % 24;
                return hour.toString().padStart(2, '0') + ':00';
            }

            trainerSelect.change(loadTrainerSlots);

            // Nếu form load lại sau lỗi validate và đã có Trainer được chọn sẵn, tải luôn khung giờ đúng ca.
            if (trainerSelect.val()) {
                loadTrainerSlots();
            }
        });
    </script>
}
