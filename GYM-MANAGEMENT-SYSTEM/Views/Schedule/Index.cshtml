        font-weight: 700;
        color: var(--gym-text);
        text-align: center;
        line-height: 1.3;
    }

    .schedule-calendar-page .sc-head-date {
        display: block;
        font-size: .72rem;
        font-weight: 600;
        color: var(--gym-muted);
    }

    .schedule-calendar-page .sc-head.today {
        color: var(--gym-accent2);
    }

        .schedule-calendar-page .sc-head.today .sc-head-date {
            color: var(--gym-accent2);
        }

    .schedule-calendar-page .sc-head.sc-head-time {
        background: var(--gym-darker);
    }

    .schedule-calendar-page .sc-time-col {
        border-right: 1px solid var(--gym-border);
        background: var(--gym-darker);
        position: relative;
    }

    .schedule-calendar-page .sc-hour-label {
        position: absolute;
        right: 8px;
        transform: translateY(-50%);
        font-size: .72rem;
        color: var(--gym-muted);
        font-weight: 600;
    }

    .schedule-calendar-page .sc-day-col {
        position: relative;
        border-right: 1px solid var(--gym-border);
        background-color: var(--gym-card);
        background-image: repeating-linear-gradient(to bottom, var(--gym-border) 0, var(--gym-border) 1px, transparent 1px, transparent var(--sc-hour-h));
    }

        .schedule-calendar-page .sc-day-col:last-child {
            border-right: none;
        }

    .schedule-calendar-page .sc-event {
        position: absolute;
        border-radius: 8px;
        border: 1px solid;
        padding: 4px 6px;
        overflow: hidden;
        font-size: .72rem;
        line-height: 1.25;
        cursor: default;
        transition: box-shadow .15s;
    }

        .schedule-calendar-page .sc-event:hover {
            box-shadow: 0 4px 16px rgba(0,0,0,.45);
            z-index: 5;
        }

        .schedule-calendar-page .sc-event.inactive {
            background: var(--gym-card-hover) !important;
            border-color: var(--gym-border) !important;
            color: var(--gym-muted) !important;
        }

    .schedule-calendar-page .sc-event-name {
        font-weight: 700;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
        margin-right: 16px;
    }

    .schedule-calendar-page .sc-event-time {
        opacity: .85;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .schedule-calendar-page .sc-event-note {
        opacity: .75;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .schedule-calendar-page .sc-event-tag {
        display: inline-block;
        font-size: .62rem;
        font-weight: 700;
        background: rgba(255,255,255,.15);
        color: inherit;
        border-radius: 999px;
        padding: 0 6px;
        margin-top: 2px;
    }

    .schedule-calendar-page .sc-kebab {
        position: absolute;
        top: 2px;
        right: 2px;
        width: 18px;
        height: 18px;
        border: none;
        background: rgba(0,0,0,.18);
        border-radius: 5px;
        font-size: .65rem;
        color: inherit;
        line-height: 18px;
        padding: 0;
    }

        .schedule-calendar-page .sc-kebab:hover {
            background: rgba(0,0,0,.35);
        }

    .schedule-calendar-page .sc-event.inactive .sc-kebab {
        background: rgba(255,255,255,.1);
    }

        .schedule-calendar-page .sc-event.inactive .sc-kebab:hover {
            background: rgba(255,255,255,.2);
        }

    .schedule-calendar-page .sc-dropdown .dropdown-item {
        font-size: .85rem;
        padding: .45rem .9rem;
    }

    .schedule-calendar-page .sc-dropdown form {
        margin: 0;
    }

    .schedule-calendar-page .sc-empty {
        text-align: center;
        padding: 3.5rem 1rem;
        color: var(--gym-muted);
    }
</style>

<div class="schedule-calendar-page" style="--sc-hour-h:@(pxPerHour)px">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-3">
        <div>
            <h1 class="sc-title">🗓️ Lịch làm việc huấn luyện viên</h1>
            <p class="sc-subtitle">Các buổi tập đã đặt trong tuần </p>
        </div>
        <a asp-action="Create" class="btn btn-sc-primary">
            <i class="fas fa-plus me-2"></i>Đặt lịch hộ thành viên
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="sc-alert success"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="sc-alert error"><i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div>
    }

    <!-- Filter by trainer -->
    <div class="sc-filter">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-md-6">
                <label class="form-label mb-1">Lọc theo huấn luyện viên</label>
                <select name="trainerId" class="form-select" onchange="this.form.submit()">
                    <option value="">Tất cả huấn luyện viên</option>
                    @foreach (var trainer in (IEnumerable<dynamic>)ViewBag.Trainers)
                    {
                        <option value="@trainer.Id" selected="@(ViewBag.SelectedTrainerId == (int)trainer.Id)">@trainer.FullName</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <button type="submit" class="btn btn-sc-secondary w-100">
                    <i class="fas fa-filter me-2"></i>Lọc
                </button>
            </div>
            @if (ViewBag.SelectedTrainerId != null)
            {
                <div class="col-md-3">
                    <a asp-action="Index" class="btn btn-sc-secondary w-100">
                        <i class="fas fa-times me-2"></i>Xóa lọc
                    </a>
                </div>
            }
        </form>
    </div>

    <div class="sc-week-nav">
        <div class="sc-week-label">
            📅 Tuần: @weekStart.ToString("dd/MM") – @weekEnd.ToString("dd/MM/yyyy")
        </div>
        <div class="sc-week-buttons">
            <a class="btn-week" asp-action="Index"
               asp-route-week="@weekStart.AddDays(-7).ToString("yyyy-MM-dd")"
               asp-route-trainerId="@ViewBag.SelectedTrainerId">
                <i class="fas fa-chevron-left me-1"></i>Tuần trước
            </a>
            <a class="btn-week @(isCurrentWeek ? "today" : "")" asp-action="Index"
               asp-route-trainerId="@ViewBag.SelectedTrainerId">
                Hôm nay
            </a>
            <a class="btn-week" asp-action="Index"
               asp-route-week="@weekStart.AddDays(7).ToString("yyyy-MM-dd")"
               asp-route-trainerId="@ViewBag.SelectedTrainerId">
                Tuần sau<i class="fas fa-chevron-right ms-1"></i>
            </a>
        </div>
    </div>

    @if (bookingList.Any())
    {
        <div class="sc-calendar">
            <div class="sc-scroll">
                <div class="sc-grid">
                    <!-- Header row -->
                    <div class="sc-head sc-head-time"></div>
                    @foreach (var date in weekDates)
                    {
                        bool isToday = date == DateOnly.FromDateTime(DateTime.Today);
                        <div class="sc-head @(isToday ? "today" : "")">
                            @dayLabels[date.DayOfWeek]
                            <span class="sc-head-date">@date.ToString("dd/MM")</span>
                        </div>
                    }

                    <!-- Time axis -->
                    <div class="sc-time-col" style="height:@(totalHeight)px">
                        @for (int h = minHour; h < maxHour; h++)
                        {
                            <span class="sc-hour-label" style="top:@((h - minHour) * pxPerHour)px">@($"{h:00}:00")</span>
                        }
                    </div>

                    <!-- Day columns -->
                    @foreach (var date in weekDates)
                    {
                        <div class="sc-day-col" style="height:@(totalHeight)px">
                            @foreach (var ev in eventsByDate[date])
                            {
                                var status = ev.Booking.Status;
                                bool isCancelled = status == "Cancelled";

                                string evBg = status switch
                                {
                                    "Confirmed" => "linear-gradient(135deg, var(--gym-accent), var(--gym-accent2))",
                                    "Completed" => "linear-gradient(135deg, #16a34a, #22c55e)",
                                    "Pending" => "linear-gradient(135deg, #ca8a04, #eab308)",
                                    "NoShow" or "PtNoShow" => "linear-gradient(135deg, #dc2626, #ef4444)",
                                    _ => "var(--gym-card-hover)"
                                };
                                string evBorder = status switch
                                {
                                    "Confirmed" => "var(--gym-accent)",
                                    "Completed" => "#16a34a",
                                    "Pending" => "#ca8a04",
                                    "NoShow" or "PtNoShow" => "#dc2626",
                                    _ => "var(--gym-border)"
                                };
                                string evText = isCancelled ? "var(--gym-muted)" : "#fff";

                                int topPx = (ev.StartMinutes - minHour * 60);
                                int heightPx = Math.Max(20, ev.EndMinutes - ev.StartMinutes);
                                double widthPct = 100.0 / ev.LaneCount;
                                double leftPct = ev.Lane * widthPct;

                                <div class="sc-event @(isCancelled ? "inactive" : "")"
                                     data-trainer="@ev.Booking.TrainerName"
                                     data-student="@ev.Booking.MemberName"
                                     data-date="@ev.Booking.WorkDate.ToString("dd/MM/yyyy")"
                                     data-time="@($"{ev.Booking.StartTime.Hour:00}:{ev.Booking.StartTime.Minute:00}") - @($"{ev.Booking.EndTime.Hour:00}:{ev.Booking.EndTime.Minute:00}")"
                                     data-status="@statusLabels.GetValueOrDefault(status, status)"
                                     data-notes="@ev.Booking.Notes"
                                     data-id="@ev.Booking.Id"
                                     style="top:@(topPx)px; height:@(heightPx)px; left:calc(@(leftPct.ToString("0.##"))% + 2px); width:calc(@(widthPct.ToString("0.##"))% - 4px); background:@evBg; border-color:@evBorder; color:@evText;"
                                     title="@ev.Booking.MemberName · HLV @ev.Booking.TrainerName · @($"{ev.Booking.StartTime.Hour:00}:{ev.Booking.StartTime.Minute:00}") - @($"{ev.Booking.EndTime.Hour:00}:{ev.Booking.EndTime.Minute:00}")@(string.IsNullOrWhiteSpace(ev.Booking.Notes) ? "" : " · " + ev.Booking.Notes)">

                                    <div class="sc-event-name">@ev.Booking.MemberName</div>
                                    <div class="sc-event-time">@($"{ev.Booking.StartTime.Hour:00}:{ev.Booking.StartTime.Minute:00}")–@($"{ev.Booking.EndTime.Hour:00}:{ev.Booking.EndTime.Minute:00}")</div>
                                    <div class="sc-event-note">HLV: @ev.Booking.TrainerName</div>
                                    <span class="sc-event-tag">@statusLabels.GetValueOrDefault(status, status)</span>

                                    <div class="dropdown sc-dropdown">
                                        <button type="button" class="sc-kebab" data-bs-toggle="dropdown" aria-expanded="false" title="Tùy chọn">
                                            <i class="fas fa-ellipsis-v"></i>
                                        </button>
                                        <ul class="dropdown-menu dropdown-menu-end">
                                            @if (status == "Pending")
                                            {
                                                <li>
                                                    <form asp-action="Confirm" asp-route-id="@ev.Booking.Id" method="post">
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="fas fa-check me-2"></i>Xác nhận
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            @if (status == "Pending" || status == "Confirmed")
                                            {
                                                <li>
                                                    <form asp-action="Complete" asp-route-id="@ev.Booking.Id" method="post">
                                                        <button type="submit" class="dropdown-item">
                                                            <i class="fas fa-flag-checkered me-2"></i>Hoàn thành
                                                        </button>
                                                    </form>
                                                </li>
                                                <li><hr class="dropdown-divider" /></li>
                                                <li>
                                                    <form asp-action="Cancel" asp-route-id="@ev.Booking.Id" method="post" onsubmit="return confirm('Hủy buổi tập này?');">
                                                        <button type="submit" class="dropdown-item text-danger">
                                                            <i class="fas fa-times me-2"></i>Hủy
                                                        </button>
                                                    </form>
                                                </li>
                                            }
                                            @if (status != "Pending" && status != "Confirmed")
                                            {
                                                <li><span class="dropdown-item-text text-muted small">Không có hành động khả dụng</span></li>
                                            }
                                        </ul>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="sc-empty">
            <i class="fas fa-calendar-times mb-3" style="font-size:2.5rem;color:#d1d5db"></i>
            <p class="mb-3">Chưa có buổi tập nào được đặt trong tuần này.</p>
            <a asp-action="Create" class="btn btn-sc-primary">
                <i class="fas fa-plus me-2"></i>Đặt lịch hộ thành viên
            </a>
        </div>
    }
</div>

