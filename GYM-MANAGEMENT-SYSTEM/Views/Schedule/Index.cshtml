            }

        .schedule-calendar-page .sc-week-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .6rem;
            margin-bottom: 1rem;
        }

        .schedule-calendar-page .sc-week-label {
            font-weight: 700;
            color: var(--gym-text);
            font-size: .95rem;
        }

        .schedule-calendar-page .sc-week-buttons {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .schedule-calendar-page .btn-week {
            background: var(--gym-card-hover);
            border: 1px solid var(--gym-border);
            color: var(--gym-text);
            font-weight: 600;
            font-size: .85rem;
            padding: .5rem 1rem;
            border-radius: 8px;
            transition: border-color .15s, color .15s;
            white-space: nowrap;
        }

    .btn-week:hover {
        border-color: var(--gym-accent);
        color: var(--gym-accent2);
    }

    .btn-week.today {
        border-color: var(--gym-accent);
        color: var(--gym-accent2);
    }

    /* ── Calendar grid ── */
    .schedule-calendar-page .sc-calendar {
        border: 1px solid var(--gym-border);
        border-radius: 14px;
        overflow: hidden;
    }

