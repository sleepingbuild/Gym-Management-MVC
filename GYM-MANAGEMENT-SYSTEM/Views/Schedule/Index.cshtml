@model IEnumerable<GYM_MANAGEMENT_SYSTEM.ViewModels.ScheduleBookingViewModel>
@{
    ViewData["Title"] = "Lịch làm việc huấn luyện viên";

    var dayLabels = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday, "Thứ 2" }, { DayOfWeek.Tuesday, "Thứ 3" }, { DayOfWeek.Wednesday, "Thứ 4" },
        { DayOfWeek.Thursday, "Thứ 5" }, { DayOfWeek.Friday, "Thứ 6" }, { DayOfWeek.Saturday, "Thứ 7" },
        { DayOfWeek.Sunday, "Chủ nhật" }
    };

    var statusLabels = new Dictionary<string, string>
{
    { "Pending", "Chờ xác nhận" }, { "Confirmed", "Đã xác nhận" },
    { "Completed", "Hoàn thành" }, { "Cancelled", "Đã hủy" },
    { "NoShow", "Vắng mặt (Member)" }, { "PtNoShow", "Vắng mặt (PT)" }
};

    DateOnly weekStart = ViewBag.WeekStart;
    DateOnly weekEnd = ViewBag.WeekEnd;
    var weekDates = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList();
    bool isCurrentWeek = weekStart == ViewBag.ThisWeekStart;

    var bookingList = (Model ?? Enumerable.Empty<GYM_MANAGEMENT_SYSTEM.ViewModels.ScheduleBookingViewModel>()).ToList();

    // Giờ hoạt động cố định của phòng gym (07:00–21:00), tự nới rộng nếu có
    // booking cũ (tạo trước khi áp dụng khung giờ cố định) nằm ngoài khoảng này.
    TimeOnly workStart = ViewBag.WorkingHourStart;
    TimeOnly workEnd = ViewBag.WorkingHourEnd;
    int minHour = workStart.Hour, maxHour = workEnd.Hour;
    if (bookingList.Any())
    {
        minHour = Math.Min(minHour, bookingList.Min(b => b.StartTime.Hour));
        maxHour = Math.Max(maxHour, bookingList.Max(b => b.EndTime.Minute > 0 ? b.EndTime.Hour + 1 : b.EndTime.Hour));
    }
    const int pxPerHour = 64;
    int totalHeight = (maxHour - minHour) * pxPerHour;

    var eventsByDate = weekDates.ToDictionary(
        date => date,
        date => AssignLanes(bookingList
            .Where(b => b.WorkDate == date)
            .Select(b => new CalEvent
            {
                Booking = b,
                StartMinutes = b.StartTime.Hour * 60 + b.StartTime.Minute,
                EndMinutes = Math.Max(b.EndTime.Hour * 60 + b.EndTime.Minute, b.StartTime.Hour * 60 + b.StartTime.Minute + 20)
            }).ToList())
    );
}

@functions {
    public class CalEvent
    {
        public GYM_MANAGEMENT_SYSTEM.ViewModels.ScheduleBookingViewModel Booking { get; set; } = default!;
        public int StartMinutes { get; set; }
        public int EndMinutes { get; set; }
        public int Lane { get; set; }
        public int LaneCount { get; set; } = 1;
    }

    // Greedy lane assignment so overlapping bookings on the same day sit side by
    // side instead of stacking on top of one another.
    public List<CalEvent> AssignLanes(List<CalEvent> events)
    {
        var sorted = events.OrderBy(e => e.StartMinutes).ThenBy(e => e.EndMinutes).ToList();
        var active = new List<(int end, int lane)>();
        var cluster = new List<CalEvent>();

        void FlushCluster()
        {
            if (cluster.Count == 0) return;
            int laneCount = cluster.Max(e => e.Lane) + 1;
            foreach (var e in cluster) e.LaneCount = laneCount;
            cluster.Clear();
        }

        foreach (var e in sorted)
        {
            active.RemoveAll(a => a.end <= e.StartMinutes);
            if (active.Count == 0) FlushCluster();

            var usedLanes = active.Select(a => a.lane).ToHashSet();
            int lane = 0;
            while (usedLanes.Contains(lane)) lane++;

            e.Lane = lane;
            active.Add((e.EndMinutes, lane));
            cluster.Add(e);
        }
        FlushCluster();
        return sorted;
    }
}

<style>
    /* Dark calendar, matching the rest of IronFit's theme. */
    .schedule-calendar-page {
        background: var(--gym-card);
        color: var(--gym-text);
        border-radius: 20px;
        border: 1px solid var(--gym-border);
        box-shadow: 0 20px 50px rgba(0, 0, 0, .4);
        padding: 1.75rem;
        margin: 1.5rem 0;
    }

        .schedule-calendar-page .sc-title {
            font-size: 1.7rem;
            font-weight: 800;
