            border-radius: 10px;
            box-shadow: 0 4px 14px rgba(249, 115, 22, .3);
            transition: transform .15s, box-shadow .15s;
        }

            .schedule-calendar-page .btn-sc-primary:hover {
                color: #fff;
                transform: translateY(-1px);
                box-shadow: 0 6px 18px rgba(249, 115, 22, .4);
            }

        .schedule-calendar-page .sc-alert {
            border-radius: 10px;
            padding: .8rem 1rem;
            font-size: .9rem;
            margin-bottom: 1rem;
        }

            .schedule-calendar-page .sc-alert.success {
                background: rgba(34, 197, 94, .12);
                border: 1px solid rgba(34, 197, 94, .3);
                color: var(--success-green);
            }

            .schedule-calendar-page .sc-alert.error {
