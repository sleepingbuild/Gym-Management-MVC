        color: var(--gym-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .02em;
        margin-bottom: 2px;
    }

    #scBookingInfoModal .bi-value {
        font-size: .95rem;
        font-weight: 600;
        color: var(--gym-text);
    }

    #scBookingInfoModal .bi-status {
        display: inline-block;
        font-size: .72rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 2px 10px;
        background: var(--gym-accent);
        color: #fff;
    }
</style>

<!-- Modal: thông tin buổi tập -->
<div class="modal fade" id="scBookingInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-dumbbell me-2"></i>Chi tiết buổi tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-user-tie"></i></div>
                    <div>
                        <div class="bi-label">Huấn luyện viên</div>
                        <div class="bi-value" id="scBiTrainer">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-user"></i></div>
                    <div>
                        <div class="bi-label">Khách hàng</div>
                        <div class="bi-value" id="scBiStudent">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-calendar-day"></i></div>
                    <div>
                        <div class="bi-label">Ngày tập</div>
                        <div class="bi-value" id="scBiDate">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <div class="bi-label">Giờ tập</div>
                        <div class="bi-value" id="scBiTime">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-flag"></i></div>
                    <div>
                        <div class="bi-label">Trạng thái</div>
                        <span class="bi-status" id="scBiStatus">—</span>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-align-left"></i></div>
                    <div>
                        <div class="bi-label">Ghi chú</div>
                        <div class="bi-value" id="scBiNotes" style="font-weight:400">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--gym-border)">
                <a href="#" id="scBiDetailLink" class="btn btn-sc-secondary btn-sm">
                    <i class="fas fa-external-link-alt me-2"></i>Xem trang chi tiết đầy đủ
                </a>
                <button type="button" class="btn btn-sc-primary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.querySelectorAll('.sc-event').forEach(function(el) {
        el.addEventListener('click', function(e) {
            if (e.target.closest('.sc-kebab, .sc-dropdown, .dropdown-menu')) {
                return;
            }

            document.getElementById('scBiTrainer').textContent = el.dataset.trainer || '—';
            document.getElementById('scBiStudent').textContent = el.dataset.student || '—';
            document.getElementById('scBiDate').textContent = el.dataset.date || '—';
            document.getElementById('scBiTime').textContent = el.dataset.time || '—';
            document.getElementById('scBiStatus').textContent = el.dataset.status || '—';
            document.getElementById('scBiNotes').textContent = el.dataset.notes && el.dataset.notes.trim() !== ''
                ? el.dataset.notes
                : 'Không có ghi chú';

            const detailLink = document.getElementById('scBiDetailLink');
            detailLink.href = '@Url.Action("Details", "Booking")/' + el.dataset.id;

            const modal = bootstrap.Modal.getOrCreateInstance(document.getElementById('scBookingInfoModal'));
            modal.show();
        });
    });
</script>
