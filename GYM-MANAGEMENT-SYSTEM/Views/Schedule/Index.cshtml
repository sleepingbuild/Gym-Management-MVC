                    background: var(--gym-card);
                    color: var(--gym-text);
                }

        .schedule-calendar-page .btn-sc-secondary {
            background: var(--gym-card-hover);
            border: 1px solid var(--gym-border);
            color: var(--gym-text);
            font-weight: 600;
            border-radius: 8px;
            transition: border-color .15s, color .15s;
        }

            .schedule-calendar-page .btn-sc-secondary:hover {
