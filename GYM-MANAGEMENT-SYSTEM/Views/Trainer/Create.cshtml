@model GYM_MANAGEMENT_SYSTEM.ViewModels.TrainerCreateViewModel
@{
    ViewData["Title"] = "Thêm huấn luyện viên";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-user-plus me-2"></i>Thêm huấn luyện viên
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post" enctype="multipart/form-data">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="display:@(ViewData.ModelState.IsValid ? "none" : "block")"></div>

                        <div class="mb-4 text-center">
                            <label class="form-label d-block">
                                <i class="fas fa-camera me-2"></i>Ảnh đại diện
                            </label>
                            <div class="auth-icon mb-2" style="width: 90px; height: 90px; margin: 0 auto;">
                                <i class="fas fa-user-tie" style="font-size: 2.2rem;"></i>
                            </div>
                            <input asp-for="AvatarFile" class="form-control" type="file" accept="image/png,image/jpeg,image/webp" style="max-width: 320px; margin: 0 auto;" />
                            <span asp-validation-for="AvatarFile" class="text-danger small"></span>
                            <div class="small mt-1" style="color: var(--gym-muted);">JPG, PNG hoặc WEBP, tối đa 5MB (không bắt buộc).</div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="FullName" class="form-label">
                                    <i class="fas fa-user me-2"></i>Họ và tên
                                </label>
                                <input asp-for="FullName" class="form-control" />
                                <span asp-validation-for="FullName" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Specialization" class="form-label">
                                    <i class="fas fa-tag me-2"></i>Chuyên môn
                                </label>
                                <input asp-for="Specialization" class="form-control" placeholder="VD: Yoga, Gym, Pilates" />
                                <span asp-validation-for="Specialization" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DateOfBirth" class="form-label">
                                <i class="fas fa-birthday-cake me-2"></i>Ngày sinh
                            </label>
                            <input asp-for="DateOfBirth" class="form-control" type="date" />
                            <span asp-validation-for="DateOfBirth" class="text-danger small"></span>
                            <div class="small mt-1" style="color: var(--gym-muted);">Huấn luyện viên phải từ 18 tuổi trở lên (tính theo ngày đăng ký).</div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Bio" class="form-label">
                                <i class="fas fa-align-left me-2"></i>Tiểu sử
                            </label>
                            <textarea asp-for="Bio" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Bio" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Email" class="form-label">
                                    <i class="fas fa-envelope me-2"></i>Email
                                </label>
                                <input asp-for="Email" class="form-control" />
                                <span asp-validation-for="Email" class="text-danger small"></span>
                                <div class="small mt-1" style="color: var(--gym-muted);">Dùng làm tài khoản đăng nhập cho HLV (mật khẩu tạm sẽ được cấp sau khi tạo).</div>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Phone" class="form-label">
                                    <i class="fas fa-phone me-2"></i>Số điện thoại
                                </label>
                                <input asp-for="Phone" class="form-control" />
                                <span asp-validation-for="Phone" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4 form-check">
                            <input asp-for="IsAvailable" class="form-check-input" />
                            <label asp-for="IsAvailable" class="form-check-label">
                                <i class="fas fa-check-circle me-2" style="color: var(--success-green);"></i>
                                Đang hoạt động
                            </label>
                        </div>

                        <div class="mb-4 p-3" style="background:var(--gym-input);border-radius:10px;border:1px solid var(--gym-border);">
                            <label class="form-label fw-bold mb-2">
                                <i class="fas fa-business-time me-2"></i>Ca làm việc
                            </label>
                            <div class="row">
                                <div class="col-md-6 mb-2 mb-md-0">
                                    <label asp-for="ShiftStartTime" class="form-label small">Giờ bắt đầu</label>
                                    <input asp-for="ShiftStartTime" class="form-control" type="time" />
                                    <span asp-validation-for="ShiftStartTime" class="text-danger small"></span>
                                </div>
                                <div class="col-md-6">
                                    <label asp-for="ShiftEndTime" class="form-label small">Giờ kết thúc</label>
                                    <input asp-for="ShiftEndTime" class="form-control" type="time" />
                                    <span asp-validation-for="ShiftEndTime" class="text-danger small"></span>
                                </div>
                            </div>
                            <div class="small mt-2" style="color: var(--gym-muted);">
                                Để trống nếu chưa muốn đặt ca riêng — hệ thống sẽ dùng mặc định 07:00–21:00. Member chỉ đặt lịch được với HLV này trong đúng khung giờ ca làm việc.
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fitness-primary flex-grow-1">
                                <i class="fas fa-save me-2"></i>Tạo huấn luyện viên
                            </button>
                            <a asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
