@model IEnumerable<GYM_MANAGEMENT_SYSTEM.ViewModels.TrainerIndexViewModel>
@{
    ViewData["Title"] = "Huấn luyện viên";
    var isAdmin = User.IsInRole("Admin");
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
        <div>
            <h1 class="fitness-title">👥 Huấn luyện viên</h1>
            <p class="text-muted mb-0">
                @(isAdmin ? "Quản lý hồ sơ và trạng thái huấn luyện viên" : "Chọn huấn luyện viên phù hợp và đặt lịch tập ngay")
            </p>
        </div>
        @if (isAdmin)
        {
            <a asp-action="Create" class="btn btn-fitness-primary">
                <i class="fas fa-user-plus me-2"></i>Thêm huấn luyện viên
            </a>
        }
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success mb-4">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var trainer in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card-fitness h-100">
                        <div class="card-body text-center">
                            @if (!string.IsNullOrEmpty(trainer.AvatarPath))
                            {
                                <img src="@trainer.AvatarPath" alt="@trainer.FullName"
                                     style="width:72px;height:72px;border-radius:50%;object-fit:cover;border:2px solid var(--gym-border);margin:0 auto;display:block;" />
                            }
                            else
                            {
                                <div class="auth-icon" style="width: 72px; height: 72px; margin: 0 auto;">
                                    <i class="fas fa-user-tie" style="font-size: 2rem;"></i>
                                </div>
                            }
                            <h5 class="text-white mt-3 mb-1">@trainer.FullName</h5>
                            <p class="text-muted small mb-2">@trainer.Specialization</p>
                            <span class="badge-fitness @trainer.StatusBadgeClass mb-3">
                                @trainer.StatusText
                            </span>

                            @if (!string.IsNullOrWhiteSpace(trainer.Bio))
                            {
                                <p class="text-muted small" style="min-height:40px;">
                                    @(trainer.Bio.Length > 90 ? trainer.Bio.Substring(0, 90) + "…" : trainer.Bio)
                                </p>
                            }

                            <div class="d-flex gap-2 justify-content-center mt-3 flex-wrap">
                                <a asp-action="Details" asp-route-id="@trainer.Id" class="btn btn-sm btn-fitness-secondary">
                                    <i class="fas fa-eye me-1"></i>Chi tiết
                                </a>

                                @if (isAdmin)
                                {
                                    <a asp-action="Edit" asp-route-id="@trainer.Id" class="btn btn-sm btn-fitness-secondary">
                                        <i class="fas fa-edit me-1"></i>Sửa
                                    </a>
                                    <form asp-action="Delete" asp-route-id="@trainer.Id" method="post"
                                          onsubmit="return confirm('Xóa huấn luyện viên này?');" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-fitness-secondary" style="color:var(--gym-danger)">
                                            <i class="fas fa-trash me-1"></i>Xóa
                                        </button>
                                    </form>
                                }
                                else if (trainer.IsAvailable)
                                {
                                    <a asp-controller="Booking" asp-action="Create" asp-route-trainerId="@trainer.Id" class="btn btn-sm btn-fitness-primary">
                                        <i class="fas fa-calendar-plus me-1"></i>Đăng ký tập
                                    </a>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card-fitness">
            <div class="card-body text-center py-5">
                <i class="fas fa-user-tie mb-3" style="font-size:2.5rem;color:var(--gym-border)"></i>
                <p class="text-muted mb-3">Chưa có huấn luyện viên nào.</p>
                @if (isAdmin)
                {
                    <a asp-action="Create" class="btn btn-fitness-primary">
                        <i class="fas fa-user-plus me-2"></i>Thêm huấn luyện viên đầu tiên
                    </a>
                }
            </div>
        </div>
    }
</div>
