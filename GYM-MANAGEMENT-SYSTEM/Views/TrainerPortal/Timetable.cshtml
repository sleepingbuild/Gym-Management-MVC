@model List<GYM_MANAGEMENT_SYSTEM.ViewModels.TrainerBookingViewModel>
@{
    ViewData["Title"] = "Thời khoá biểu";

    var dayLabels = new Dictionary<DayOfWeek, string>
    {
        { DayOfWeek.Monday, "Thứ 2" }, { DayOfWeek.Tuesday, "Thứ 3" }, { DayOfWeek.Wednesday, "Thứ 4" },
        { DayOfWeek.Thursday, "Thứ 5" }, { DayOfWeek.Friday, "Thứ 6" }, { DayOfWeek.Saturday, "Thứ 7" },
        { DayOfWeek.Sunday, "Chủ nhật" }
    };

    DateOnly weekStart = ViewBag.WeekStart;
    DateOnly weekEnd = ViewBag.WeekEnd;
    var weekDates = Enumerable.Range(0, 7).Select(i => weekStart.AddDays(i)).ToList();
    bool isCurrentWeek = weekStart == ViewBag.ThisWeekStart;

    var bookingList = Model ?? new List<GYM_MANAGEMENT_SYSTEM.ViewModels.TrainerBookingViewModel>();

    int minHour = 6, maxHour = 22;
    var parsedTimes = bookingList.Select(b => ParseSlot(b.TimeSlot)).Where(t => t != null).Select(t => t!.Value).ToList();
    if (parsedTimes.Any())
    {
        minHour = Math.Min(minHour, parsedTimes.Min(t => t.start.Hour));
        maxHour = Math.Max(maxHour, parsedTimes.Max(t => t.end.Minute > 0 ? t.end.Hour + 1 : t.end.Hour));
    }
    const int pxPerHour = 64;
    int totalHeight = (maxHour - minHour) * pxPerHour;

    var eventsByDate = weekDates.ToDictionary(
        date => date,
        date => AssignLanes(bookingList
            .Where(b => DateOnly.FromDateTime(b.SessionDate) == date && ParseSlot(b.TimeSlot) != null)
            .Select(b =>
            {
                var t = ParseSlot(b.TimeSlot)!.Value;
                return new CalEvent
                {
                    Booking = b,
                    StartMinutes = t.start.Hour * 60 + t.start.Minute,
                    EndMinutes = Math.Max(t.end.Hour * 60 + t.end.Minute, t.start.Hour * 60 + t.start.Minute + 20)
                };
            }).ToList())
    );
}

@functions {
    public class CalEvent
    {
        public GYM_MANAGEMENT_SYSTEM.ViewModels.TrainerBookingViewModel Booking { get; set; } = default!;
        public int StartMinutes { get; set; }
        public int EndMinutes { get; set; }
        public int Lane { get; set; }
        public int LaneCount { get; set; } = 1;
    }
    public (TimeOnly start, TimeOnly end)? ParseSlot(string? timeSlot)
    {
        if (string.IsNullOrWhiteSpace(timeSlot)) return null;
        var parts = timeSlot.Split('-', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries);
        if (parts.Length < 1) return null;
        if (!TimeOnly.TryParse(parts[0], out var start)) return null;
        var end = start.AddHours(1);
        if (parts.Length >= 2 && TimeOnly.TryParse(parts[1], out var parsedEnd))
        {
            end = parsedEnd;
        }
        return (start, end);
    }

    // Greedy lane assignment so overlapping bookings on the same day sit side
    // by side instead of stacking on top of one another.
    public List<CalEvent> AssignLanes(List<CalEvent> events)
    {
        var sorted = events.OrderBy(e => e.StartMinutes).ThenBy(e => e.EndMinutes).ToList();
        var active = new List<(int end, int lane)>();
        var cluster = new List<CalEvent>();

        void FlushCluster()
        {
            if (cluster.Count == 0) return;
            int laneCount = cluster.Max(e => e.Lane) + 1;
            foreach (var e in cluster) e.LaneCount = laneCount;
            cluster.Clear();
        }

        foreach (var e in sorted)
        {
            active.RemoveAll(a => a.end <= e.StartMinutes);
            if (active.Count == 0) FlushCluster();

            var usedLanes = active.Select(a => a.lane).ToHashSet();
            int lane = 0;
            while (usedLanes.Contains(lane)) lane++;

            e.Lane = lane;
            active.Add((e.EndMinutes, lane));
            cluster.Add(e);
        }
        FlushCluster();
        return sorted;
    }
}

<style>
    /* Scoped to this page only. */
    .trainer-schedule-page {
        background: var(--gym-card);
        color: var(--gym-text);
        border-radius: 20px;
        border: 1px solid var(--gym-border);
