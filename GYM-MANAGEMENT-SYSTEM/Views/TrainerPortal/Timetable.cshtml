            border-bottom: none;
        }

    #bookingInfoModal .bi-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: var(--gym-card-hover);
        color: var(--gym-accent2);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    #bookingInfoModal .bi-label {
        font-size: .72rem;
        color: var(--gym-muted);
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: .02em;
        margin-bottom: 2px;
    }

    #bookingInfoModal .bi-value {
        font-size: .95rem;
        font-weight: 600;
        color: var(--gym-text);
    }

    #bookingInfoModal .bi-status {
        display: inline-block;
        font-size: .72rem;
        font-weight: 700;
        border-radius: 999px;
        padding: 2px 10px;
        background: var(--gym-accent);
        color: #fff;
    }
</style>

<!-- Modal: thông tin buổi tập -->
<div class="modal fade" id="bookingInfoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fas fa-dumbbell me-2"></i>Chi tiết buổi tập</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Đóng"></button>
            </div>
            <div class="modal-body">
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-user-tie"></i></div>
                    <div>
                        <div class="bi-label">Huấn luyện viên</div>
                        <div class="bi-value" id="biTrainer">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-user"></i></div>
                    <div>
                        <div class="bi-label">Khách hàng</div>
                        <div class="bi-value" id="biStudent">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-calendar-day"></i></div>
                    <div>
                        <div class="bi-label">Ngày tập</div>
                        <div class="bi-value" id="biDate">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-clock"></i></div>
                    <div>
                        <div class="bi-label">Giờ tập</div>
                        <div class="bi-value" id="biTime">—</div>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-flag"></i></div>
                    <div>
                        <div class="bi-label">Trạng thái</div>
                        <span class="bi-status" id="biStatus">—</span>
                    </div>
                </div>
                <div class="bi-row">
                    <div class="bi-icon"><i class="fas fa-align-left"></i></div>
                    <div>
                        <div class="bi-label">Ghi chú</div>
                        <div class="bi-value" id="biNotes" style="font-weight:400">—</div>
                    </div>
                </div>
            </div>
            <div class="modal-footer" style="border-top:1px solid var(--gym-border)">
                <form id="biConfirmForm" method="post" style="margin:0">
                    @Html.AntiForgeryToken()
                    <button type="submit" id="biConfirmBtn" class="btn btn-success btn-sm" style="display:none">
                        <i class="fas fa-check me-2"></i>Xác nhận buổi tập
                    </button>
                </form>
                <form id="biCancelForm" method="post" style="margin:0"
                      onsubmit="return confirm('Bạn chắc chắn muốn huỷ buổi tập này?');">
                    @Html.AntiForgeryToken()
                     <button type="submit" id="biCancelBtn" class="btn btn-fitness-danger btn-sm" style="display:none">
                      <i class="fas fa-times me-2"></i>Huỷ buổi tập
                    </button>
                </form>
                <a href="#" id="biDetailLink" class="btn btn-fitness-secondary btn-sm">
                    <i class="fas fa-external-link-alt me-2"></i>Xem trang chi tiết đầy đủ
                </a>
                <button type="button" class="btn btn-fitness-primary btn-sm" data-bs-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<script>
    document.getElementById('bookingInfoModal').addEventListener('show.bs.modal', function(event) {
    const trigger = event.relatedTarget;
    if (!trigger) return;

    document.getElementById('biTrainer').textContent = trigger.dataset.trainer || '—';
    document.getElementById('biStudent').textContent = trigger.dataset.student || '—';
    document.getElementById('biDate').textContent = trigger.dataset.date || '—';
    document.getElementById('biTime').textContent = trigger.dataset.time || '—';
    document.getElementById('biStatus').textContent = trigger.dataset.status || '—';
    document.getElementById('biNotes').textContent = trigger.dataset.notes && trigger.dataset.notes.trim() !== ''
        ? trigger.dataset.notes
        : 'Không có ghi chú';

    const detailLink = document.getElementById('biDetailLink');
    detailLink.href = '@Url.Action("BookingDetail", "TrainerPortal")/' + trigger.dataset.id;

    const confirmForm = document.getElementById('biConfirmForm');
    const confirmBtn = document.getElementById('biConfirmBtn');
    if (trigger.dataset.status === 'Pending') {
        confirmForm.action = '@Url.Action("Confirm", "TrainerPortal")/' + trigger.dataset.id;
        confirmBtn.style.display = 'inline-block';
    } else {
        confirmBtn.style.display = 'none';
    }

    const cancelForm = document.getElementById('biCancelForm');
    const cancelBtn = document.getElementById('biCancelBtn');
    if (trigger.dataset.status === 'Pending' || trigger.dataset.status === 'Confirmed') {
        cancelForm.action = '@Url.Action("Cancel", "TrainerPortal")/' + trigger.dataset.id;
        cancelBtn.style.display = 'inline-block';
    } else {
        cancelBtn.style.display = 'none';
    }
});
</script>

<div class="trainer-schedule-page" style="--ts-hour-h:@(pxPerHour)px">
    <div class="mb-2">
        <h1 class="ts-title">🗓️ Thời khoá biểu</h1>
        <p class="ts-subtitle">Toàn bộ buổi tập đã được đặt với bạn — bấm vào 1 buổi để xem chi tiết</p>
    </div>

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="ts-alert error"><i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]</div>
    }
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="ts-alert success"><i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]</div>
    }

    <div class="ts-week-nav">
        <div class="ts-week-label">
            📅 Tuần: @weekStart.ToString("dd/MM") – @weekEnd.ToString("dd/MM/yyyy")
        </div>
        <div class="ts-week-buttons">
            <a class="btn-week" asp-action="Timetable" asp-route-week="@weekStart.AddDays(-7).ToString("yyyy-MM-dd")">
                <i class="fas fa-chevron-left me-1"></i>Tuần trước
            </a>
            <a class="btn-week @(isCurrentWeek ? "today" : "")" asp-action="Timetable">
                Hôm nay
            </a>
            <a class="btn-week" asp-action="Timetable" asp-route-week="@weekStart.AddDays(7).ToString("yyyy-MM-dd")">
                Tuần sau<i class="fas fa-chevron-right ms-1"></i>
            </a>
        </div>
    </div>

    <div class="ts-legend">
        <span class="ts-legend-item"><span class="ts-legend-dot" style="background:var(--gym-accent2)"></span>Chờ xác nhận / Đã xác nhận</span>
        <span class="ts-legend-item"><span class="ts-legend-dot" style="background:var(--success-green)"></span>Hoàn thành</span>
        <span class="ts-legend-item"><span class="ts-legend-dot" style="background:var(--gym-muted)"></span>Đã hủy</span>
    </div>

    @if (bookingList.Any())
    {
        <div class="ts-calendar">
            <div class="ts-scroll">
                <div class="ts-grid">
                    <!-- Header row -->
                    <div class="ts-head ts-head-time"></div>
                    @foreach (var date in weekDates)
                    {
                        bool isToday = date == DateOnly.FromDateTime(DateTime.Today);
                        <div class="ts-head @(isToday ? "today" : "")">
                            @dayLabels[date.DayOfWeek]
                            <span class="ts-head-date">@date.ToString("dd/MM")</span>
                        </div>
                    }

                    <!-- Time axis -->
                    <div class="ts-time-col" style="height:@(totalHeight)px">
                        @for (int h = minHour; h < maxHour; h++)
                        {
                            <span class="ts-hour-label" style="top:@((h - minHour) * pxPerHour)px">@($"{h:00}:00")</span>
                        }
                    </div>

                    <!-- Day columns -->
                    @foreach (var date in weekDates)
                    {
                        <div class="ts-day-col" style="height:@(totalHeight)px">
                            @foreach (var ev in eventsByDate[date])
                            {
                                string evBg = ev.Booking.Status switch
                                {
                                    "Completed" => "rgba(34,197,94,.18)",
                                    "Cancelled" => "var(--gym-card-hover)",
                                    _ => "linear-gradient(135deg, var(--gym-accent), var(--gym-accent2))"
                                };
                                string evBorder = ev.Booking.Status switch
                                {
                                    "Completed" => "var(--success-green)",
                                    "Cancelled" => "var(--gym-border)",
                                    _ => "var(--gym-accent)"
                                };
                                string evText = ev.Booking.Status switch
                                {
                                    "Completed" => "var(--success-green)",
                                    "Cancelled" => "var(--gym-muted)",
                                    _ => "#fff"
                                };
                                int topPx = (ev.StartMinutes - minHour * 60);
                                int heightPx = Math.Max(20, ev.EndMinutes - ev.StartMinutes);
                                double widthPct = 100.0 / ev.LaneCount;
                                double leftPct = ev.Lane * widthPct;

                                <div class="ts-event" data-bs-toggle="modal" data-bs-target="#bookingInfoModal"
                                     data-trainer="@ViewBag.TrainerName"
                                     data-student="@ev.Booking.StudentName"
                                     data-date="@ev.Booking.SessionDate.ToString("dd/MM/yyyy")"
                                     data-time="@ev.Booking.TimeSlot"
                                     data-status="@ev.Booking.Status"
                                     data-notes="@ev.Booking.Notes"
                                     data-id="@ev.Booking.Id"
                                     style="top:@(topPx)px; height:@(heightPx)px; left:calc(@(leftPct.ToString("0.##"))% + 2px); width:calc(@(widthPct.ToString("0.##"))% - 4px); background:@evBg; border-color:@evBorder; color:@evText;"
                                     title="@ev.Booking.StudentName · @ev.Booking.TimeSlot · @ev.Booking.Status">
                                    <div class="ts-event-name">@ev.Booking.StudentName</div>
                                    <div class="ts-event-time">@ev.Booking.TimeSlot</div>
                                    <span class="ts-event-status">@ev.Booking.Status</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="ts-empty">
            <i class="fas fa-calendar-times mb-3" style="font-size:2.5rem;color:var(--gym-border)"></i>
            <p class="mb-0">Chưa có buổi tập nào trong tuần này.</p>
        </div>
    }
</div>