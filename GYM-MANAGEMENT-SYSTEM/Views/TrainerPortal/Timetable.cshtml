                color: var(--gym-danger);
            }

        .trainer-schedule-page .ts-legend {
            display: flex;
            flex-wrap: wrap;
            gap: .5rem 1.1rem;
            margin: 1rem 0;
        }

        .trainer-schedule-page .ts-legend-item {
            display: flex;
            align-items: center;
            gap: 6px;
            font-size: .8rem;
            color: var(--gym-muted);
        }

        .trainer-schedule-page .ts-legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 3px;
            flex-shrink: 0;
        }

        .trainer-schedule-page .ts-week-nav {
            display: flex;
            align-items: center;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: .6rem;
            margin-bottom: .25rem;
        }

        .trainer-schedule-page .ts-week-label {
            font-weight: 700;
            color: var(--gym-text);
            font-size: .95rem;
        }

        .trainer-schedule-page .ts-week-buttons {
            display: flex;
            align-items: center;
            gap: .5rem;
        }

        .trainer-schedule-page .btn-week {
            background: var(--gym-card-hover);
            border: 1px solid var(--gym-border);
            color: var(--gym-text);
            font-weight: 600;
            font-size: .85rem;
            padding: .5rem 1rem;
            border-radius: 8px;
            transition: border-color .15s, color .15s;
