                color: var(--gym-accent2);
            }

            .trainer-schedule-page .btn-week.today {
                border-color: var(--gym-accent);
                color: var(--gym-accent2);
            }

        /* ── Calendar grid ── */
        .trainer-schedule-page .ts-calendar {
            border: 1px solid var(--gym-border);
            border-radius: 14px;
