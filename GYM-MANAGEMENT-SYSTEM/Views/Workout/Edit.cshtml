@model GYM_MANAGEMENT_SYSTEM.ViewModels.WorkoutEditViewModel
@{
    ViewData["Title"] = "Sửa tiến trình";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-md-10">
            <div class="card-fitness">
                <div class="card-header">
                    <i class="fas fa-edit me-2"></i>Sửa tiến trình
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />
                        <input type="hidden" asp-for="UserId" />
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="Weight" class="form-label">
                                    <i class="fas fa-weight me-2"></i>Cân nặng (kg)
                                </label>
                                <input asp-for="Weight" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="Weight" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 mb-3">
                                <label asp-for="Height" class="form-label">
                                    <i class="fas fa-ruler-vertical me-2"></i>Chiều cao (cm)
                                </label>
                                <input asp-for="Height" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="Height" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="BodyFatPercentage" class="form-label">
                                    <i class="fas fa-percent me-2"></i>Tỷ lệ mỡ (%)
                                </label>
                                <input asp-for="BodyFatPercentage" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="BodyFatPercentage" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="MuscleMass" class="form-label">
                                    <i class="fas fa-dumbbell me-2"></i>Cơ bắp
                                </label>
                                <input asp-for="MuscleMass" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="MuscleMass" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="WaistCircumference" class="form-label">
                                    <i class="fas fa-arrows-alt-h me-2"></i>Vòng eo (cm)
                                </label>
                                <input asp-for="WaistCircumference" class="form-control" type="number" step="0.1" />
                                <span asp-validation-for="WaistCircumference" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Notes" class="form-label">
                                <i class="fas fa-align-left me-2"></i>Ghi chú
                            </label>
                            <textarea asp-for="Notes" class="form-control" rows="2"></textarea>
                            <span asp-validation-for="Notes" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-fitness-primary flex-grow-1">
                                <i class="fas fa-save me-2"></i>Cập nhật
                            </button>
                            <a asp-action="Index" class="btn btn-fitness-secondary">
                                <i class="fas fa-times me-2"></i>Hủy
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}