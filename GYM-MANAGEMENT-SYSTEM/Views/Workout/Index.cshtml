@model IEnumerable<GYM_MANAGEMENT_SYSTEM.ViewModels.WorkoutIndexViewModel>
@{
    ViewData["Title"] = "Tiến trình tập luyện";
    var stats = ViewBag.Statistics as GYM_MANAGEMENT_SYSTEM.ViewModels.WorkoutStatisticsViewModel;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="fitness-title">📊 Tiến trình tập luyện</h1>
            <p class="text-muted">Theo dõi sự phát triển của bạn theo thời gian</p>
        </div>
        <a asp-action="Create" class="btn btn-fitness-primary">
            <i class="fas fa-plus-circle me-2"></i>Ghi nhận mới
        </a>
    </div>

    <!-- Messages -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">
            <i class="fas fa-check-circle me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">
            <i class="fas fa-exclamation-circle me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Statistics Cards -->
    @if (stats != null && stats.TotalRecords > 0)
    {
        <div class="row mb-4">
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon orange">
                        <i class="fas fa-weight"></i>
                    </div>
                    <div class="stat-number">@stats.LatestWeightDisplay</div>
                    <div class="stat-label">Cân nặng hiện tại</div>
                    @if (stats.WeightChange != 0)
                    {
                        <div class="stat-change @(stats.WeightChange >= 0 ? "positive" : "negative")">
                            <i class="fas @(stats.WeightChange >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                            @stats.WeightChangeDisplay
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon blue">
                        <i class="fas fa-ruler-vertical"></i>
                    </div>
                    <div class="stat-number">@stats.LatestBMIDisplay</div>
                    <div class="stat-label">Chỉ số BMI</div>
                    @if (stats.BMIChange != 0)
                    {
                        <div class="stat-change @(stats.BMIChange >= 0 ? "positive" : "negative")">
                            <i class="fas @(stats.BMIChange >= 0 ? "fa-arrow-up" : "fa-arrow-down")"></i>
                            @stats.BMIChangeDisplay
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon green">
                        <i class="fas fa-percent"></i>
                    </div>
                    <div class="stat-number">@stats.LatestBodyFatDisplay</div>
                    <div class="stat-label">Tỷ lệ mỡ</div>
                    @if (stats.BodyFatChange != 0)
                    {
                        <div class="stat-change @(stats.BodyFatChange <= 0 ? "positive" : "negative")">
                            <i class="fas @(stats.BodyFatChange <= 0 ? "fa-arrow-down" : "fa-arrow-up")"></i>
                            @stats.BodyFatChangeDisplay
                        </div>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <div class="stat-card">
                    <div class="stat-icon yellow">
                        <i class="fas fa-clock"></i>
                    </div>
                    <div class="stat-number">@stats.TotalRecords</div>
                    <div class="stat-label">Tổng ghi nhận</div>
                    <div class="stat-change" style="font-size: 0.75rem;">
                        <i class="fas fa-calendar-alt me-1"></i>
                        @stats.LastUpdatedDisplay
                    </div>
                </div>
            </div>
        </div>

        <!-- Recent Progress -->
        <div class="card-fitness mb-4">
            <div class="card-header">
                <i class="fas fa-chart-line me-2"></i>Tiến trình gần đây
            </div>
            <div class="card-body">
                <canvas id="progressChart" height="150"></canvas>
            </div>
        </div>
    }

    <!-- Progress List -->
    @if (Model.Any())
    {
        <div class="card-fitness">
            <div class="card-header">
                <i class="fas fa-list me-2"></i>Lịch sử ghi nhận
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-fitness mb-0">
                        <thead>
                            <tr>
                                <th>Ngày</th>
                                <th>Cân nặng</th>
                                <th>BMI</th>
                                <th>Tỷ lệ mỡ</th>
                                <th>Cơ bắp</th>
                                <th>Vòng eo</th>
                                <th>Thao tác</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td>@item.DateDisplay</td>
                                    <td>@item.WeightDisplay</td>
                                    <td>
                                        <span class="badge-fitness @(item.BMIStatus == "success" ? "green" : "orange")">
                                            @item.BMI
                                        </span>
                                    </td>
                                    <td>@item.BodyFatDisplay</td>
                                    <td>@item.MuscleMass</td>
                                    <td>@item.WaistCircumference cm</td>
                                    <td>
                                        <div class="d-flex gap-1">
                                            <a asp-action="Details" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-fitness-outline-light">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                            <a asp-action="Edit" asp-route-id="@item.Id"
                                               class="btn btn-sm btn-fitness-secondary">
                                                <i class="fas fa-edit"></i>
                                            </a>
                                            <form asp-action="Delete" asp-route-id="@item.Id" method="post" style="display:inline;">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-fitness-danger"
                                                        onclick="return confirm('Bạn có chắc muốn xóa ghi nhận này?')">
                                                    <i class="fas fa-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="text-center py-5">
            <i class="fas fa-dumbbell" style="font-size: 4rem; color: var(--text-muted);"></i>
            <h4 class="text-muted mt-3">Chưa có dữ liệu tiến trình</h4>
            <p class="text-muted">Hãy ghi nhận tiến trình tập luyện đầu tiên</p>
            <a asp-action="Create" class="btn btn-fitness-primary mt-3">
                <i class="fas fa-plus-circle me-2"></i>Ghi nhận ngay
            </a>
        </div>
    }
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        $(document).ready(function() {
        // Load chart data
        $.ajax({
        url: '@Url.Action("Chart", "Workout")',
        type: 'GET',
        success: function(data) {
        if (data && data.length > 0) {
        var ctx = document.getElementById('progressChart').getContext('2d');
        new Chart(ctx, {
        type: 'line',
        data: {
        labels: data.map(d => d.date),
        datasets: [
        {
        label: 'Cân nặng (kg)',
        data: data.map(d => d.weight),
        borderColor: '#FF6B00',
        backgroundColor: 'rgba(255, 107, 0, 0.1)',
        fill: true,
        tension: 0.3
        },
        {
        label: 'Tỷ lệ mỡ (%)',
        data: data.map(d => d.bodyFat),
        borderColor: '#2979FF',
        backgroundColor: 'rgba(41, 121, 255, 0.1)',
        fill: true,
        tension: 0.3
        },
        {
        label: 'Cơ bắp',
        data: data.map(d => d.muscleMass),
        borderColor: '#00E676',
        backgroundColor: 'rgba(0, 230, 118, 0.1)',
        fill: true,
        tension: 0.3
        }
        ]
        },
        options: {
        responsive: true,
        plugins: {
        legend: {
        labels: {
        color: '#AAAAAA'
        }
        }
        },
        scales: {
        y: {
        grid: {
        color: 'rgba(255,255,255,0.05)'
        },
        ticks: {
        color: '#AAAAAA'
        }
        },
        x: {
        grid: {
        color: 'rgba(255,255,255,0.05)'
        },
        ticks: {
        color: '#AAAAAA'
        }
        }
        }
        }
        });
        }
        }
        });
        });
    </script>
}